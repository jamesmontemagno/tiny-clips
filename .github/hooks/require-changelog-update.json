{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "/usr/bin/env python3 .github/hooks/require_changelog_update.py postToolUse",
        "powershell": "python .github/hooks/require_changelog_update.py postToolUse",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "/usr/bin/env python3 .github/hooks/require_changelog_update.py agentStop",
        "powershell": "python .github/hooks/require_changelog_update.py agentStop",
        "timeoutSec": 10
      }
    ]
  }
}