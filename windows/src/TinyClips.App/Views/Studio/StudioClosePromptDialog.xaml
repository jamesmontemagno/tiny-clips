<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TinyClips.App.Views.Studio.StudioClosePromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keep this recording?"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Keep as draft"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="380" Spacing="16">
        <TextBlock
            Text="It has not been saved as a project. Keep it as a draft to finish later from the Clips Library, or delete it."
            TextWrapping="Wrap" />

        <!--
            Esc has to mean Cancel and Enter must never delete, so Delete sits here, looking like
            the Delete button of the video trimmer. It is taken into the tab order once the
            dialog has put the first focus on its default button.
        -->
        <Button
            x:Name="DeleteButton"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="StudioClosePromptDeleteButton"
            AutomationProperties.Name="Delete recording"
            Click="OnDeleteClick"
            IsTabStop="False"
            ToolTipService.ToolTip="Delete this recording. This cannot be undone.">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="DeleteIcon" FontSize="14" />
                <TextBlock Text="Delete" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
