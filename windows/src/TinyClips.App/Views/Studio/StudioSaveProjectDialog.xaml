<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="TinyClips.App.Views.Studio.StudioSaveProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Save project"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!--
        Where the project is saved as a folder: a name, and the folder it is made in. The name
        box is the first control that can take the focus, so the dialog opens with the focus in
        it and the suggested name selected.
    -->
    <StackPanel Width="420" Spacing="12">
        <TextBlock
            AutomationProperties.AutomationId="StudioSaveProjectIntro"
            Text="Saves the recordings and a .tinyclips file in a folder of this name. The folder opens in Studio again, on this PC or another."
            TextWrapping="Wrap" />
        <TextBox
            x:Name="NameBox"
            AutomationProperties.AutomationId="StudioSaveProjectNameBox"
            AutomationProperties.Name="Folder name"
            Header="Folder name"
            IsSpellCheckEnabled="False"
            MaxLength="80"
            TextChanged="OnNameChanged" />
        <StackPanel Spacing="4">
            <TextBlock AutomationProperties.AccessibilityView="Raw" Text="In" />
            <!--  The whole path, which may be long: it wraps, and a screen reader reads it as the place.  -->
            <TextBlock
                x:Name="PlaceText"
                AutomationProperties.AutomationId="StudioSaveProjectPlaceText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="False"
                TextWrapping="Wrap" />
            <Button
                x:Name="ChooseFolderButton"
                Margin="0,4,0,0"
                AutomationProperties.AutomationId="StudioSaveProjectChooseFolderButton"
                AutomationProperties.Name="Choose folder&#x2026;"
                Click="OnChooseFolderClick"
                ToolTipService.ToolTip="Choose the folder the project's folder is made in">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        Glyph="&#xE8B7;" />
                    <TextBlock AutomationProperties.AccessibilityView="Raw" Text="Choose folder&#x2026;" />
                </StackPanel>
            </Button>
        </StackPanel>
        <!--
            Why the project cannot be saved there, when it cannot: the name is taken, the folder
            holds something that is not part of a project, or the name cannot be a folder's. It
            is read out when it appears.
        -->
        <TextBlock
            x:Name="ProblemText"
            AutomationProperties.AutomationId="StudioSaveProjectProblemText"
            AutomationProperties.LiveSetting="Assertive"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
