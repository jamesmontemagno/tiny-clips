<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TinyClips.App.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--  A single popup card. The window region is clipped to the same rounded shape
          (see code-behind) so the card fills the window edge-to-edge.  -->
    <Border
        x:Name="RootBorder"
       BorderThickness="0"
        CornerRadius="8">
        <TextBlock
            x:Name="CountText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Countdown"
            AutomationProperties.LiveSetting="Assertive"
            FontSize="64"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            RenderTransformOrigin="0.5,0.5"
            Text="3">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="CountScale" ScaleX="1" ScaleY="1" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Border>
</Window>
