<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.StoreReviewPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Enjoying Tiny Clips?">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="StoreReviewTitleBar"
            IsPaneToggleButtonVisible="False"
            Title="Enjoying Tiny Clips?">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            Grid.Row="1"
            Padding="36,20,36,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <Image
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Tiny Clips app icon"
                    Source="ms-appx:///Assets/AppIcon-512.png"
                    Stretch="Uniform" />

                <StackPanel Spacing="7">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Enjoying Tiny Clips?"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxWidth="380"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="A Microsoft Store review helps other people discover Tiny Clips. If something could be better, tell us directly."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="ReviewBusyPanel"
                    AutomationProperties.LiveSetting="Polite"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="Collapsed">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="True"
                        VerticalAlignment="Center" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Opening the Microsoft Store…" />
                </StackPanel>

                <InfoBar
                    x:Name="ReviewStatusBar"
                    AutomationProperties.AutomationId="StoreReviewStatusInfoBar"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Review couldn't be opened" />
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="28,16"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="NotNowButton"
                    AutomationProperties.AutomationId="StoreReviewNotNowButton"
                    AutomationProperties.HelpText="Close this prompt without opening the Microsoft Store or feedback."
                    AutomationProperties.Name="Not now"
                    Click="OnNotNowClicked"
                    Content="Not now" />
                <Button
                    x:Name="FeedbackButton"
                    AutomationProperties.AutomationId="StoreReviewFeedbackButton"
                    AutomationProperties.HelpText="Open Tiny Clips feedback form instead of the Microsoft Store."
                    AutomationProperties.Name="Send feedback"
                    Click="OnFeedbackClicked"
                    Content="Send feedback" />
                <Button
                    x:Name="ReviewButton"
                    AutomationProperties.AutomationId="StoreReviewConfirmButton"
                    AutomationProperties.HelpText="Open the Microsoft Store rate and review flow for Tiny Clips."
                    AutomationProperties.Name="Leave a review"
                    Click="OnReviewClicked"
                    Content="Leave a review"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
