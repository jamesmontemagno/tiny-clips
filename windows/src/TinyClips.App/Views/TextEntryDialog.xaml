<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TinyClips.App.TextEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:studio="using:TinyClips.App.Controls.Studio"
    Title="Add text"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="OK"
    mc:Ignorable="d">

    <StackPanel MinWidth="520" Spacing="16">
        <TextBox
            x:Name="EntryBox"
            MinHeight="96"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="TextDialogEntry"
            AutomationProperties.Name="Text"
            Header="Text"
            PlaceholderText="Type your text…"
            TextChanged="OnTextChanged"
            TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Style" />
                <TextBlock
                    x:Name="TextStyleCustomLabel"
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Custom"
                    Visibility="Collapsed" />
            </Grid>
            <studio:StudioSegmented
                x:Name="TextStyleChoice"
                HorizontalAlignment="Stretch"
                studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                AutomationProperties.AutomationId="TextDialogStyleChoice"
                AutomationProperties.Name="Text style"
                SelectionChanged="OnPresetChanged">
                <controls:SegmentedItem Content="Plain" />
                <controls:SegmentedItem Content="Light" />
                <controls:SegmentedItem Content="Dark" />
                <controls:SegmentedItem Content="Accent" />
            </studio:StudioSegmented>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="FontCombo"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="TextDialogFont"
                AutomationProperties.Name="Font"
                Header="Font"
                SelectionChanged="OnFontChanged" />
            <NumberBox
                x:Name="SizeBox"
                Grid.Column="1"
                AutomationProperties.AutomationId="TextDialogSize"
                AutomationProperties.Name="Font size"
                Header="Size"
                Maximum="400"
                Minimum="8"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnSizeChanged" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    x:Name="BoldToggle"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.AutomationId="TextDialogBold"
                    AutomationProperties.Name="Bold"
                    Click="OnFormattingChanged"
                    ToolTipService.ToolTip="Bold">
                    <FontIcon FontSize="16" Glyph="&#xE8DD;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ItalicToggle"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.AutomationId="TextDialogItalic"
                    AutomationProperties.Name="Italic"
                    Click="OnFormattingChanged"
                    ToolTipService.ToolTip="Italic">
                    <FontIcon FontSize="16" Glyph="&#xE8DB;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="UnderlineToggle"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.AutomationId="TextDialogUnderline"
                    AutomationProperties.Name="Underline"
                    Click="OnFormattingChanged"
                    ToolTipService.ToolTip="Underline">
                    <FontIcon FontSize="16" Glyph="&#xE8DC;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="StrikeToggle"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.AutomationId="TextDialogStrikethrough"
                    AutomationProperties.Name="Strikethrough"
                    Click="OnFormattingChanged"
                    ToolTipService.ToolTip="Strikethrough">
                    <FontIcon FontSize="16" Glyph="&#xEDE0;" />
                </ToggleButton>
            </StackPanel>
            <local:SwatchColorPicker
                x:Name="TextColorPicker"
                Grid.Column="1"
                MinWidth="180"
                AutomationProperties.AutomationId="TextDialogColor"
                AutomationProperties.Name="Text color"
                ColorChanged="OnColorChanged"
                IsAlphaEnabled="False" />
        </Grid>

        <StackPanel Spacing="6">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Preview" />
            <Border
                MinHeight="88"
                MaxHeight="140"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Border
                    x:Name="PreviewBox"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TextDialogPreview"
                    AutomationProperties.Name="Text preview">
                    <TextBlock
                        x:Name="PreviewText"
                        HorizontalAlignment="Center"
                        MaxWidth="400"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </Border>
        </StackPanel>

        <Expander
            x:Name="BoxExpander"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="TextDialogBoxExpander"
            Header="Box details">
            <StackPanel Padding="0,12,0,0" Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Background" />
                        <local:SwatchColorPicker
                            x:Name="BackgroundColorPicker"
                            AutomationProperties.AutomationId="TextDialogBackgroundColor"
                            AutomationProperties.Name="Text box background color"
                            AllowTransparent="True"
                            ColorChanged="OnBackgroundColorChanged"
                            IsAlphaEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Border" />
                        <local:SwatchColorPicker
                            x:Name="BorderColorPicker"
                            AutomationProperties.AutomationId="TextDialogBorderColor"
                            AutomationProperties.Name="Text box border color"
                            AllowTransparent="True"
                            ColorChanged="OnBorderColorChanged"
                            IsAlphaEnabled="True" />
                    </StackPanel>
                </Grid>

                <Slider
                    x:Name="BackgroundOpacitySlider"
                    AutomationProperties.AutomationId="TextDialogBackgroundOpacity"
                    AutomationProperties.Name="Text box background opacity"
                    Header="Background opacity"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="OnBackgroundOpacityChanged" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="BorderWidthBox"
                        Grid.Column="0"
                        AutomationProperties.Name="Border width"
                        Header="Border"
                        Maximum="12"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                    <NumberBox
                        x:Name="PaddingBox"
                        Grid.Column="1"
                        AutomationProperties.Name="Padding"
                        Header="Padding"
                        Maximum="48"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                    <NumberBox
                        x:Name="CornerRadiusBox"
                        Grid.Column="2"
                        AutomationProperties.Name="Corner radius"
                        Header="Radius"
                        Maximum="32"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</ContentDialog>
