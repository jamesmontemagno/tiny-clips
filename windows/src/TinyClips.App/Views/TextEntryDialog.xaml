<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TinyClips.App.TextEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add text"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="OK"
    mc:Ignorable="d">

    <StackPanel MinWidth="380" Spacing="12">
        <StackPanel Spacing="6">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Style" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="PlainPreset" Grid.Column="0" AutomationProperties.Name="Plain text style" Click="OnPresetClick" Content="Plain" Tag="Plain" />
                <ToggleButton x:Name="LightPreset" Grid.Column="1" AutomationProperties.Name="Light text box style" Click="OnPresetClick" Content="Light" Tag="Light" />
                <ToggleButton x:Name="DarkPreset" Grid.Column="2" AutomationProperties.Name="Dark text box style" Click="OnPresetClick" Content="Dark" Tag="Dark" />
                <ToggleButton x:Name="AccentPreset" Grid.Column="3" AutomationProperties.Name="Accent text box style" Click="OnPresetClick" Content="Accent" Tag="Accent" />
            </Grid>
        </StackPanel>

        <!--  Formatting toolbar  -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <ToggleButton
                x:Name="BoldToggle"
                AutomationProperties.AutomationId="TextDialogBold"
                AutomationProperties.Name="Bold"
                Click="OnFormattingChanged"
                ToolTipService.ToolTip="Bold">
                <FontIcon FontSize="16" Glyph="&#xE8DD;" />
            </ToggleButton>
            <ToggleButton
                x:Name="ItalicToggle"
                AutomationProperties.AutomationId="TextDialogItalic"
                AutomationProperties.Name="Italic"
                Click="OnFormattingChanged"
                ToolTipService.ToolTip="Italic">
                <FontIcon FontSize="16" Glyph="&#xE8DB;" />
            </ToggleButton>
            <ToggleButton
                x:Name="UnderlineToggle"
                AutomationProperties.AutomationId="TextDialogUnderline"
                AutomationProperties.Name="Underline"
                Click="OnFormattingChanged"
                ToolTipService.ToolTip="Underline">
                <FontIcon FontSize="16" Glyph="&#xE8DC;" />
            </ToggleButton>
            <ToggleButton
                x:Name="StrikeToggle"
                AutomationProperties.AutomationId="TextDialogStrikethrough"
                AutomationProperties.Name="Strikethrough"
                Click="OnFormattingChanged"
                ToolTipService.ToolTip="Strikethrough">
                <FontIcon FontSize="16" Glyph="&#xEDE0;" />
            </ToggleButton>

            <Button
                x:Name="ColorButton"
                Width="40"
                AutomationProperties.AutomationId="TextDialogColor"
                AutomationProperties.Name="Text color"
                ToolTipService.ToolTip="Text color">
                <Border
                    x:Name="ColorSwatch"
                    Width="20"
                    Height="20"
                    CornerRadius="4" />
                <Button.Flyout>
                    <Flyout>
                        <ColorPicker
                            x:Name="TextColorPicker"
                            ColorChanged="OnColorChanged"
                            IsAlphaEnabled="False"
                            IsColorSliderVisible="True"
                            IsHexInputVisible="True" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!--  Font + size  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="FontCombo"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="TextDialogFont"
                AutomationProperties.Name="Font"
                Header="Font"
                SelectionChanged="OnFontChanged" />
            <NumberBox
                x:Name="SizeBox"
                Grid.Column="1"
                Width="120"
                AutomationProperties.AutomationId="TextDialogSize"
                AutomationProperties.Name="Font size"
                Header="Size"
                Maximum="400"
                Minimum="8"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnSizeChanged" />
        </Grid>

        <Expander Header="Box">
            <StackPanel Padding="0,8,0,0" Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackgroundColorButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Background color"
                        Content="Background">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    x:Name="BackgroundColorPicker"
                                    ColorChanged="OnBackgroundColorChanged"
                                    IsAlphaEnabled="True"
                                    IsAlphaSliderVisible="True"
                                    IsHexInputVisible="True" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="BorderColorButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Border color"
                        Content="Border">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    x:Name="BorderColorPicker"
                                    ColorChanged="OnBorderColorChanged"
                                    IsAlphaEnabled="True"
                                    IsAlphaSliderVisible="True"
                                    IsHexInputVisible="True" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="BorderWidthBox"
                        Grid.Column="0"
                        AutomationProperties.Name="Border width"
                        Header="Border"
                        Maximum="12"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                    <NumberBox
                        x:Name="PaddingBox"
                        Grid.Column="1"
                        AutomationProperties.Name="Padding"
                        Header="Padding"
                        Maximum="48"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                    <NumberBox
                        x:Name="CornerRadiusBox"
                        Grid.Column="2"
                        AutomationProperties.Name="Corner radius"
                        Header="Radius"
                        Maximum="32"
                        Minimum="0"
                        SmallChange="1"
                        ValueChanged="OnBoxMetricChanged" />
                </Grid>
            </StackPanel>
        </Expander>

        <!--  Text entry  -->
        <TextBox
            x:Name="EntryBox"
            MinHeight="80"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="TextDialogEntry"
            AutomationProperties.Name="Text"
            Header="Text"
            PlaceholderText="Type your text…"
            TextChanged="OnTextChanged"
            TextWrapping="Wrap" />

        <!--  Live preview  -->
        <Border
            MinHeight="64"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Border
                x:Name="PreviewBox"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="PreviewText"
                    TextWrapping="Wrap" />
            </Border>
        </Border>
    </StackPanel>
</ContentDialog>
