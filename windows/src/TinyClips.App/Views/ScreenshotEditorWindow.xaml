<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.ScreenshotEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:TinyClips.App.ScreenshotEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Tiny Clips — Edit Screenshot"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Edit screenshot" />
        </Grid>

        <!--  Output actions  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,10"
            Padding="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <CommandBar
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <CommandBar.Content>
                    <TextBlock
                        x:Name="ImageSizeText"
                        Margin="12,16,0,0"
                        VerticalAlignment="Center"
                        HorizontalTextAlignment="Center"
                        AutomationProperties.AutomationId="EditorImageSizeText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </CommandBar.Content>
                <AppBarButton
                    x:Name="ApplyCropButton"
                    AutomationProperties.AutomationId="EditorApplyCropButton"
                    Click="OnApplyCrop"
                    Icon="Crop"
                    IsEnabled="False"
                    Label="Apply crop"
                    ToolTipService.ToolTip="Apply crop" />
                <AppBarButton
                    x:Name="UndoButton"
                    AutomationProperties.AutomationId="EditorUndoButton"
                    Click="OnUndo"
                    Label="Undo"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="DeleteButton"
                    AutomationProperties.AutomationId="EditorDeleteButton"
                    Click="OnDeleteSelected"
                    Icon="Delete"
                    Label="Delete"
                    ToolTipService.ToolTip="Delete selected (Del)" />
                <AppBarButton
                    x:Name="ResetButton"
                    AutomationProperties.AutomationId="EditorResetButton"
                    Click="OnReset"
                    Icon="Refresh"
                    Label="Reset"
                    ToolTipService.ToolTip="Reset all edits" />
                <AppBarSeparator />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorCopyButton"
                    Click="OnCopy"
                    Icon="Copy"
                    Label="Copy"
                    ToolTipService.ToolTip="Copy to clipboard" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorSaveButton"
                    Click="OnSave"
                    Icon="Save"
                    Label="Save"
                    ToolTipService.ToolTip="Save the edited image to the current file" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorSaveAsButton"
                    Click="OnSaveCopy"
                    Icon="SaveLocal"
                    Label="Save As"
                    ToolTipService.ToolTip="Save the edited image to a new file" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorOpenFolderButton"
                    Click="OnOpenSaveFolder"
                    Icon="Folder"
                    Label="Open Folder"
                    ToolTipService.ToolTip="Open the current save folder" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorCloseButton"
                    Click="OnClose"
                    Icon="Cancel"
                    Label="Close"
                    ToolTipService.ToolTip="Close the editor" />
            </CommandBar>
        </Border>

        <!--  Content: tool rail | inspector | canvas  -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <editor:EditorToolbar
                x:Name="Toolbar"
                Grid.Column="0" />

            <editor:EditorInspector
                x:Name="Inspector"
                Grid.Column="1"
                Margin="12,0,12,0" />

            <editor:EditorCanvas
                x:Name="Canvas"
                Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
