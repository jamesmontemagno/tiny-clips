<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.ScreenshotEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:TinyClips.App.ScreenshotEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Tiny Clips — Edit Screenshot"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Native WinUI TitleBar: icon, title, drag region, and DWM chrome.  -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            AutomationProperties.AutomationId="ScreenshotEditorTitleBar"
            IsPaneToggleButtonVisible="False"
            Title="Edit Screenshot">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Output actions  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,10"
            Padding="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <CommandBar
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <CommandBar.Content>
                    <Button
                        x:Name="OutputScaleButton"
                        Margin="8,4,0,4"
                        Padding="8"
                        AutomationProperties.AutomationId="EditorOutputScaleButton"
                        AutomationProperties.Name="Output resolution"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Choose the resolution used when copying or saving the image">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="280" Padding="16" Spacing="12">
                                    <TextBlock
                                        Text="Export scale"
                                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="Choose the resolution used when copying or saving the image."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            x:Name="OutputScaleSlider"
                                            AutomationProperties.AutomationId="EditorOutputScaleSlider"
                                            AutomationProperties.Name="Export output scale"
                                            LargeChange="10"
                                            Maximum="100"
                                            Minimum="10"
                                            SmallChange="1"
                                            StepFrequency="1"
                                            Value="100"
                                            ValueChanged="OnOutputScaleChanged" />
                                        <TextBlock
                                            x:Name="OutputScaleValueText"
                                            Grid.Column="1"
                                            MinWidth="40"
                                            VerticalAlignment="Center"
                                            Text="100%"
                                            TextAlignment="Right"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <TextBlock
                            x:Name="ImageSizeText"
                            AutomationProperties.AutomationId="EditorImageSizeText"
                            HorizontalTextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Button>
                </CommandBar.Content>
                <AppBarButton
                    x:Name="ApplyCropButton"
                    AutomationProperties.AutomationId="EditorApplyCropButton"
                    Click="OnApplyCrop"
                    Icon="Crop"
                    IsEnabled="False"
                    Label="Apply crop"
                    ToolTipService.ToolTip="Apply crop" />
                <AppBarButton
                    x:Name="UndoButton"
                    AutomationProperties.AutomationId="EditorUndoButton"
                    Click="OnUndo"
                    Label="Undo"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="DeleteButton"
                    AutomationProperties.AutomationId="EditorDeleteButton"
                    Click="OnDeleteSelected"
                    Icon="Delete"
                    Label="Delete"
                    ToolTipService.ToolTip="Delete selected (Del)" />
                <AppBarButton
                    x:Name="ResetButton"
                    AutomationProperties.AutomationId="EditorResetButton"
                    Click="OnReset"
                    Icon="Refresh"
                    Label="Reset"
                    ToolTipService.ToolTip="Reset all edits" />
                <AppBarSeparator />
                <AppBarButton
                    x:Name="FindSensitiveTextButton"
                    AutomationProperties.AutomationId="EditorFindSensitiveTextButton"
                    Icon="Find"
                    Label="Find sensitive text"
                    ToolTipService.ToolTip="Find likely email addresses, phone numbers and IP addresses locally">
                    <AppBarButton.Flyout>
                        <Flyout x:Name="SensitiveTextFlyout" Placement="Bottom"
                                Opened="OnSensitiveTextReviewOpened" Closed="OnSensitiveTextReviewClosed">
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="340" Spacing="12">
                                    <TextBlock Text="Find sensitive text" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Processed only on this device using Windows OCR. Suggestions may miss sensitive text. Review the entire image before sharing."
                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar x:Name="SensitiveTextProgress" IsIndeterminate="True" Visibility="Collapsed"
                                                 AutomationProperties.Name="Finding sensitive text locally" />
                                    <TextBlock x:Name="SensitiveTextStatus" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel x:Name="SensitiveTextReviewPanel" Spacing="12" Visibility="Collapsed">
                                        <TextBlock x:Name="SensitiveTextPosition" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="SensitiveTextValue" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="EditorSensitiveTextValue" />
                                        <TextBlock x:Name="SensitiveTextDecision" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SensitiveTextPrevious" Content="Previous" Click="OnSensitiveTextPrevious"
                                                    AutomationProperties.AutomationId="EditorSensitiveTextPrevious" />
                                            <Button x:Name="SensitiveTextNext" Content="Next" Click="OnSensitiveTextNext"
                                                    AutomationProperties.AutomationId="EditorSensitiveTextNext" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Approve" Click="OnSensitiveTextApprove"
                                                    AutomationProperties.AutomationId="EditorSensitiveTextApprove"
                                                    AutomationProperties.Name="Approve this suggestion for redaction" />
                                            <Button Content="Dismiss" Click="OnSensitiveTextDismiss"
                                                    AutomationProperties.AutomationId="EditorSensitiveTextDismiss"
                                                    AutomationProperties.Name="Dismiss this suggestion" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="SensitiveTextApply" Content="Apply approved redactions" IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}" Click="OnSensitiveTextApply"
                                            AutomationProperties.AutomationId="EditorSensitiveTextApply" />
                                    <Button x:Name="SensitiveTextFindAgain" Content="Find again" Click="OnSensitiveTextFindAgain"
                                            AutomationProperties.AutomationId="EditorSensitiveTextFindAgain" />
                                    <TextBlock Text="Nothing changes until you apply. Each black redaction can be undone with Ctrl+Z."
                                               TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.AutomationId="EditorCopyButton"
                    Click="OnCopy"
                    Icon="Copy"
                    Label="Copy"
                    ToolTipService.ToolTip="Copy to clipboard (Ctrl+C)" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorSaveButton"
                    Click="OnSave"
                    Icon="Save"
                    Label="Save"
                    ToolTipService.ToolTip="Save the edited image to the current file" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorSaveAsButton"
                    Click="OnSaveCopy"
                    Icon="SaveLocal"
                    Label="Save As"
                    ToolTipService.ToolTip="Save the edited image to a new file" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorOpenFolderButton"
                    Click="OnOpenSaveFolder"
                    Icon="Folder"
                    Label="Open Folder"
                    ToolTipService.ToolTip="Open the current save folder" />
                <AppBarButton
                    x:Name="DeleteScreenshotButton"
                    AutomationProperties.AutomationId="EditorDeleteScreenshotButton"
                    AutomationProperties.Name="Delete original screenshot"
                    Click="OnDeleteScreenshot"
                    Icon="Delete"
                    Label="Delete screenshot"
                    ToolTipService.ToolTip="Delete the original screenshot" />
                <AppBarButton
                    AutomationProperties.AutomationId="EditorCloseButton"
                    Click="OnClose"
                    Icon="Cancel"
                    Label="Close"
                    ToolTipService.ToolTip="Close the editor (Esc)" />
            </CommandBar>
        </Border>

        <!--  Content: tool rail | inspector | canvas  -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <editor:EditorToolbar
                x:Name="Toolbar"
                Grid.Column="0" />

            <editor:EditorInspector
                x:Name="Inspector"
                Grid.Column="1"
                Margin="12,0,12,0" />

            <editor:EditorCanvas
                x:Name="Canvas"
                Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
