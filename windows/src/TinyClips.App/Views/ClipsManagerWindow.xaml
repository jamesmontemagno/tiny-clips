<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.ClipsManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Tiny Clips — Library"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="56"
            Padding="20,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xEB9F;" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Your captures" />
                <TextBlock
                    x:Name="LibrarySummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!--  Library toolbar  -->
        <Grid
            Grid.Row="1"
            Padding="20,12,20,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="UploadStatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />

            <Button
                x:Name="FilterButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="LibraryFilterButton"
                AutomationProperties.Name="Sort and filter clips"
                ToolTipService.ToolTip="Sort and filter clips">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE71C;" />
                    <TextBlock x:Name="FilterSummaryText" Text="All clips" />
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="10" Glyph="&#xE70D;" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="280" Spacing="12">
                            <Grid>
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sort &amp; filter" />
                                <Button
                                    x:Name="ClearFiltersButton"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    AutomationProperties.AutomationId="ClearLibraryFiltersButton"
                                    AutomationProperties.Name="Clear filters"
                                    Click="OnClearFiltersClicked"
                                    Content="Clear"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="Collapsed" />
                            </Grid>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="TYPE" />
                            <StackPanel Spacing="2">
                                <RadioButton x:Name="FilterAll" AutomationProperties.AutomationId="FilterAll" Checked="OnFilterChanged" Content="All captures" GroupName="TypeFilter" IsChecked="True" />
                                <RadioButton x:Name="FilterScreenshot" AutomationProperties.AutomationId="FilterScreenshot" Checked="OnFilterChanged" Content="Screenshots" GroupName="TypeFilter" />
                                <RadioButton x:Name="FilterVideo" AutomationProperties.AutomationId="FilterVideo" Checked="OnFilterChanged" Content="Videos" GroupName="TypeFilter" />
                                <RadioButton x:Name="FilterGif" AutomationProperties.AutomationId="FilterGif" Checked="OnFilterChanged" Content="GIFs" GroupName="TypeFilter" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="CAPTURED" />
                            <StackPanel Spacing="2">
                                <RadioButton x:Name="DateAll" AutomationProperties.AutomationId="FilterDateAll" Checked="OnFilterChanged" Content="Any time" GroupName="DateFilter" IsChecked="True" />
                                <RadioButton x:Name="DateToday" AutomationProperties.AutomationId="FilterDateToday" Checked="OnFilterChanged" Content="Today" GroupName="DateFilter" />
                                <RadioButton x:Name="DateWeek" AutomationProperties.AutomationId="FilterDateWeek" Checked="OnFilterChanged" Content="This week" GroupName="DateFilter" />
                                <RadioButton x:Name="DateMonth" AutomationProperties.AutomationId="FilterDateMonth" Checked="OnFilterChanged" Content="This month" GroupName="DateFilter" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="SORT" />
                            <StackPanel Spacing="2">
                                <RadioButton x:Name="SortNewest" AutomationProperties.AutomationId="SortNewest" Checked="OnFilterChanged" Content="Newest first" GroupName="SortFilter" IsChecked="True" />
                                <RadioButton x:Name="SortOldest" AutomationProperties.AutomationId="SortOldest" Checked="OnFilterChanged" Content="Oldest first" GroupName="SortFilter" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Grid / List toggle  -->
            <ToggleButton
                x:Name="GridViewToggle"
                Grid.Column="2"
                AutomationProperties.AutomationId="GridViewToggle"
                AutomationProperties.Name="Grid view"
                Click="OnViewModeToggled"
                IsChecked="True"
                ToolTipService.ToolTip="Toggle grid / list view">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xF0E2;" />
            </ToggleButton>

            <!--  Refresh  -->
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="RefreshButton"
                AutomationProperties.Name="Refresh"
                Click="OnRefreshClicked"
                ToolTipService.ToolTip="Refresh library">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!--  Content area  -->
        <Grid Grid.Row="2" Padding="20,0,20,20">

            <!--  Loading ring  -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True"
                Visibility="Collapsed" />

            <!--  Empty state  -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xEB9F;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Your library is ready" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="New screenshots, videos, and GIFs will appear here after they are saved." />
            </StackPanel>

            <!--  Grid view  -->
            <GridView
                x:Name="ClipsGridView"
                AutomationProperties.AutomationId="ClipsGridView"
                IsItemClickEnabled="False"
                SelectionMode="None"
                Visibility="Collapsed">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="332" ItemHeight="256" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ClipItemViewModel">
                        <Border
                            Width="320"
                            Height="244"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--  Thumbnail  -->
                                <Grid
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Source="{x:Bind Thumbnail}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind HasThumbnail}" />
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="36"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="{x:Bind TypeGlyph}"
                                        Visibility="{x:Bind NoThumbnail}" />
                                    <!--  Type badge  -->
                                    <Border
                                        Margin="6"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="{x:Bind TypeGlyph}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{x:Bind TypeLabel}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!--  Metadata  -->
                                <StackPanel Grid.Row="1" Padding="10,8,10,2" Spacing="2">
                                    <TextBlock
                                        FontSize="12"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind FileName}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind DisplayDate}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind FileSizeDisplay}" />
                                </StackPanel>

                                <!--  Action buttons  -->
                                <Grid Grid.Row="2" Padding="8,2,8,8" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Padding="8,6"
                                            AutomationProperties.AutomationId="{x:Bind GridOpenAutomationId}"
                                            AutomationProperties.Name="Open"
                                            Click="OnOpenClicked"
                                            Tag="{x:Bind Path}"
                                            ToolTipService.ToolTip="Open in editor / trimmer">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A7;" />
                                                <TextBlock Text="Open" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Padding="8,6"
                                            AutomationProperties.AutomationId="{x:Bind GridCopyAutomationId}"
                                            AutomationProperties.Name="Copy to clipboard"
                                            Click="OnCopyClicked"
                                            Tag="{x:Bind Path}"
                                            ToolTipService.ToolTip="Copy to clipboard">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8C8;" />
                                                <TextBlock Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Padding="8,6"
                                            AutomationProperties.AutomationId="{x:Bind GridMoreAutomationId}"
                                            AutomationProperties.Name="More clip actions"
                                            ToolTipService.ToolTip="More clip actions">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE712;" />
                                                <TextBlock Text="More" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind GridRevealAutomationId}"
                                                        AutomationProperties.Name="Reveal in Explorer"
                                                        Click="OnRevealClicked"
                                                        Tag="{x:Bind Path}"
                                                        Text="Reveal in Explorer">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind GridUploadAutomationId}"
                                                        AutomationProperties.Name="Upload to Uploadcare"
                                                        Click="OnUploadClicked"
                                                        Icon="Upload"
                                                        Tag="{x:Bind Path}"
                                                        Text="Upload to Uploadcare"
                                                        Visibility="{x:Bind UploadAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind GridCopyUrlAutomationId}"
                                                        AutomationProperties.Name="Copy Uploadcare URL"
                                                        Click="OnCopyUploadUrlClicked"
                                                        Icon="Copy"
                                                        Tag="{x:Bind Path}"
                                                        Text="Copy Uploadcare URL"
                                                        Visibility="{x:Bind UploadedUrlAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind GridOpenUrlAutomationId}"
                                                        AutomationProperties.Name="Open Uploadcare URL"
                                                        Click="OnOpenUploadUrlClicked"
                                                        Icon="Link"
                                                        Tag="{x:Bind Path}"
                                                        Text="Open Uploadcare URL"
                                                        Visibility="{x:Bind UploadedUrlAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind GridDeleteAutomationId}"
                                                        AutomationProperties.Name="Delete"
                                                        Click="OnDeleteClicked"
                                                        Icon="Delete"
                                                        Tag="{x:Bind Path}"
                                                        Text="Delete" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!--  List view  -->
            <ListView
                x:Name="ClipsListView"
                AutomationProperties.AutomationId="ClipsListView"
                IsItemClickEnabled="False"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ClipItemViewModel">
                        <Border
                            Margin="4,3"
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid
                                ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Preview  -->
                                <Grid
                                    x:Name="PreviewGrid"
                                    Width="112"
                                    Height="68"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Source="{x:Bind Thumbnail}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind HasThumbnail}" />
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="{x:Bind TypeGlyph}"
                                        Visibility="{x:Bind NoThumbnail}" />
                                </Grid>

                                <!--  Metadata  -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                    <!--  Filename  -->
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind FileName}" />

                                    <!--  Info row  -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind TypeLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DisplayDate}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind FileSizeDisplay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Actions  -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Padding="10,6"
                                            AutomationProperties.AutomationId="{x:Bind ListOpenAutomationId}"
                                            AutomationProperties.Name="Open"
                                            Click="OnOpenClicked"
                                            Tag="{x:Bind Path}"
                                            Style="{StaticResource AccentButtonStyle}">
                                            Open
                                        </Button>
                                        <Button
                                            Padding="10,6"
                                            AutomationProperties.AutomationId="{x:Bind ListCopyAutomationId}"
                                            AutomationProperties.Name="Copy to clipboard"
                                            Click="OnCopyClicked"
                                            Tag="{x:Bind Path}"
                                            ToolTipService.ToolTip="Copy to clipboard">
                                            Copy
                                        </Button>
                                        <Button
                                            Padding="10,6"
                                            AutomationProperties.AutomationId="{x:Bind ListMoreAutomationId}"
                                            AutomationProperties.Name="More clip actions"
                                            ToolTipService.ToolTip="More clip actions">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE712;" />
                                                <TextBlock Text="More" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind ListRevealAutomationId}"
                                                        AutomationProperties.Name="Reveal in Explorer"
                                                        Click="OnRevealClicked"
                                                        Tag="{x:Bind Path}"
                                                        Text="Reveal in Explorer">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind ListUploadAutomationId}"
                                                        AutomationProperties.Name="Upload to Uploadcare"
                                                        Click="OnUploadClicked"
                                                        Icon="Upload"
                                                        Tag="{x:Bind Path}"
                                                        Text="Upload to Uploadcare"
                                                        Visibility="{x:Bind UploadAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind ListCopyUrlAutomationId}"
                                                        AutomationProperties.Name="Copy Uploadcare URL"
                                                        Click="OnCopyUploadUrlClicked"
                                                        Icon="Copy"
                                                        Tag="{x:Bind Path}"
                                                        Text="Copy Uploadcare URL"
                                                        Visibility="{x:Bind UploadedUrlAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind ListOpenUrlAutomationId}"
                                                        AutomationProperties.Name="Open Uploadcare URL"
                                                        Click="OnOpenUploadUrlClicked"
                                                        Icon="Link"
                                                        Tag="{x:Bind Path}"
                                                        Text="Open Uploadcare URL"
                                                        Visibility="{x:Bind UploadedUrlAvailable, Mode=OneWay}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        AutomationProperties.AutomationId="{x:Bind ListDeleteAutomationId}"
                                                        AutomationProperties.Name="Delete"
                                                        Click="OnDeleteClicked"
                                                        Icon="Delete"
                                                        Tag="{x:Bind Path}"
                                                        Text="Delete" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
