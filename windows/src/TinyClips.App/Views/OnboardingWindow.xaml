<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Title="Welcome to Tiny Clips"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!--  Step-indicator dot styles — Fill is resolved from the element's live theme context,
                  which is safe in High Contrast and all other themes.  -->
            <Style
                x:Key="DotActiveStyle"
                TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style
                x:Key="DotInactiveStyle"
                TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Native WinUI TitleBar: icon, drag region, and DWM chrome.  -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            AutomationProperties.AutomationId="OnboardingTitleBar"
            IsPaneToggleButtonVisible="False"
            Title="Welcome to Tiny Clips">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Steps  -->
        <Grid Grid.Row="1" Padding="48,16">
            <!--  Step 0: Welcome  -->
            <StackPanel
                x:Name="Step0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <Image
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Tiny Clips app icon"
                    Source="ms-appx:///Assets/AppIcon-512.png"
                    Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="Welcome to Tiny Clips" />
                <TextBlock
                    MaxWidth="540"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="A tiny tray app for fast screenshots, screen recordings, and GIFs. Let's take a quick tour."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Step 1: How it works  -->
            <StackPanel
                x:Name="Step1"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Capture and create" />
                <local:GuideRow
                    Glyph="&#xE722;"
                    Subtitle="Snap a region, window, or full screen to a PNG or JPEG."
                    Title="Screenshot" />
                <local:GuideRow
                    Glyph="&#xE714;"
                    Subtitle="Record your screen to a shareable MP4 video."
                    Title="Video" />
                <local:GuideRow
                    Glyph="&#xE786;"
                    Subtitle="Capture a short looping GIF, great for chats and issues."
                    Title="GIF" />
                <local:GuideRow
                    Glyph="&#xE8D4;"
                    Subtitle="With Studio enabled in Settings, choose Studio from the tray to record your screen and optional camera separately, edit the project, and export an MP4."
                    Title="Studio Mode" />
            </StackPanel>

            <!--  Step 2: Preferences  -->
            <ScrollViewer
                x:Name="Step2"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
            <StackPanel MaxWidth="560" Spacing="12" Padding="0,8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Make it yours"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Changes apply as you make them. You can change these later in Settings."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <controls:SettingsCard
                    Header="Launch at login"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7E8;}">
                    <controls:SettingsCard.Description>
                        <StackPanel>
                            <TextBlock Text="Start Tiny Clips when I sign in to Windows." TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind ViewModel.LaunchAtLoginNote, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasLaunchAtLoginNote, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <ToggleSwitch
                        AutomationProperties.AutomationId="OnboardingLaunchAtLoginToggle"
                        AutomationProperties.HelpText="Start Tiny Clips when you sign in to Windows."
                        AutomationProperties.Name="Launch at login"
                        IsEnabled="{x:Bind ViewModel.CanChangeLaunchAtLogin, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="Copy screenshots to clipboard"
                    Description="Paste your screenshot straight into a chat or document."
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}">
                    <ToggleSwitch
                        AutomationProperties.Name="Copy screenshots to clipboard"
                        IsOn="{x:Bind ViewModel.CopyScreenshotToClipboard, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="Open screenshot editor"
                    Description="Annotate or crop after capturing. Turn off for fewer interruptions."
                    HeaderIcon="{ui:FontIcon Glyph=&#xE70F;}">
                    <ToggleSwitch
                        AutomationProperties.Name="Open screenshot editor after capture"
                        IsOn="{x:Bind ViewModel.ShowScreenshotEditor, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="Recording countdown"
                    Description="Get ready before recording video or GIF."
                    HeaderIcon="{ui:FontIcon Glyph=&#xE916;}">
                    <ToggleSwitch
                        AutomationProperties.Name="Countdown before video and GIF recording"
                        AutomationProperties.HelpText="Custom means video and GIF have different saved settings."
                        OffContent="{x:Bind ViewModel.RecordingCountdownOffContent, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.RecordingCountdown, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Header="Notify after saving"
                    Description="Confirm when your capture has been saved."
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <ToggleSwitch
                        AutomationProperties.Name="Notify after saving"
                        IsOn="{x:Bind ViewModel.ShowSaveNotifications, Mode=TwoWay}" />
                </controls:SettingsCard>
                <TextBlock x:Name="NotificationStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <HyperlinkButton Content="Windows notification settings" Click="OnNotificationSettingsClicked" />
            </StackPanel>
            </ScrollViewer>

            <!--  Step 3: Shortcuts  -->
            <ScrollViewer
                x:Name="Step3"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel MaxWidth="560" Spacing="12" Padding="0,8">
                    <TextBlock Text="Your capture shortcuts" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="These work system-wide. Edit, clear, or reset each shortcut. Record video makes an ordinary recording, not Studio." TextWrapping="Wrap" />
                    <StackPanel x:Name="ShortcutRows" Spacing="8" />
                    <InfoBar x:Name="ShortcutStatus" IsOpen="False" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Stop recording: Ctrl+Shift+S (fixed)" TextWrapping="Wrap" />
                    <TextBlock Text="More shortcuts are available in Settings → Keyboard shortcuts. Changes already made remain if you skip setup." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </ScrollViewer>

            <!--  Step 4: All set  -->
            <ScrollViewer
                x:Name="Step4"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="You're all set" />
                <Border
                    Padding="16,12"
                    Margin="0,8,0,0"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.Name="Windows taskbar illustration. Tiny Clips is in the system tray near the clock."
                    AutomationProperties.AccessibilityView="Content">
                    <Grid ColumnSpacing="16" AutomationProperties.AccessibilityView="Raw">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Taskbar" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="14" Glyph="&#xE70E;" />
                            <Border
                                Padding="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Image Width="24" Height="24" Source="ms-appx:///Assets/TrayIcon.ico" />
                            </Border>
                            <FontIcon FontSize="14" Glyph="&#xE767;" />
                            <TextBlock VerticalAlignment="Center" Text="12:00" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Click Tiny Clips in the taskbar's system tray, near the clock, to start a capture. If it's hidden, open the up arrow."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Or use a key binding"
                    TextWrapping="Wrap" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Screenshot" />
                            <TextBlock
                                x:Name="ScreenshotShortcut"
                                Grid.Column="1"
                                FontFamily="Consolas" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Record video" />
                            <TextBlock
                                x:Name="VideoShortcut"
                                Grid.Column="1"
                                FontFamily="Consolas" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Record GIF" />
                            <TextBlock
                                x:Name="GifShortcut"
                                Grid.Column="1"
                                FontFamily="Consolas" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Footer  -->
        <Grid
            Grid.Row="2"
            Padding="24,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SkipButton"
                    AutomationProperties.AutomationId="OnboardingSkipButton"
                    AutomationProperties.HelpText="Close setup and keep changes already made"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSkipClicked"
                    Content="Skip" />
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="OnboardingBackButton"
                    Click="OnBackClicked"
                    Content="Back"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Ellipse
                    x:Name="Dot0"
                    Width="8"
                    Height="8"
                    Style="{StaticResource DotActiveStyle}" />
                <Ellipse
                    x:Name="Dot1"
                    Width="8"
                    Height="8"
                    Style="{StaticResource DotInactiveStyle}" />
                <Ellipse
                    x:Name="Dot2"
                    Width="8"
                    Height="8"
                    Style="{StaticResource DotInactiveStyle}" />
                <Ellipse
                    x:Name="Dot3"
                    Width="8"
                    Height="8"
                    Style="{StaticResource DotInactiveStyle}" />
                <Ellipse
                    x:Name="Dot4"
                    Width="8"
                    Height="8"
                    Style="{StaticResource DotInactiveStyle}" />
            </StackPanel>

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="OnboardingNextButton"
                Click="OnNextClicked"
                Content="Next"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
