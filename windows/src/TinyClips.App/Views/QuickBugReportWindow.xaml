<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.QuickBugReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tiny Clips — File a Bug">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Native WinUI TitleBar: icon, drag region, and DWM chrome.  -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            AutomationProperties.AutomationId="QuickBugReportTitleBar"
            IsPaneToggleButtonVisible="False"
            Title="File a Bug">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            Grid.Row="1"
            Padding="24,16,24,12"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tell us what happened" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Describe the problem and Tiny Clips will prepare a GitHub issue with your Windows and app details."
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.AutomationId="BugReportTitleTextBox"
                    AutomationProperties.Name="Bug title"
                    Header="Title"
                    PlaceholderText="A short summary of the problem"
                    TextChanged="OnReportTextChanged" />

                <TextBox
                    x:Name="HappenedBox"
                    MinHeight="200"
                    AutomationProperties.AutomationId="BugReportDescriptionTextBox"
                    AutomationProperties.Name="What happened"
                    AcceptsReturn="True"
                    Header="What happened?"
                    PlaceholderText="What did you expect, and what happened instead?"
                    TextChanged="OnReportTextChanged"
                    TextWrapping="Wrap" />

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            x:Name="AppInfoText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12,24,20"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="CancelBugReportButton"
                    AutomationProperties.Name="Cancel bug report"
                    Click="OnCancelClicked"
                    Content="Cancel" />
                <Button
                    x:Name="FileBugButton"
                    AutomationProperties.AutomationId="FileBugOnGitHubButton"
                    AutomationProperties.Name="File bug on GitHub"
                    Click="OnFileBugClicked"
                    Content="File on GitHub"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
