<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TinyClips.App.WhatsNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyClips.App"
    Title="What's new in Tiny Clips">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            AutomationProperties.AutomationId="WhatsNewTitleBar"
            IsPaneToggleButtonVisible="False"
            Title="What's new in Tiny Clips">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" Padding="32,8,32,20" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center" Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock
                        x:Name="VersionText"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Meet Tiny Clips Studio"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Your recording. Your finishing touches."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Image
                        Height="230"
                        AutomationProperties.Name="Studio illustration: a screen recording and camera bubble above a colorful editing timeline"
                        Stretch="Uniform">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/Studio/whats-new-studio.svg" />
                        </Image.Source>
                    </Image>
                </Border>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Record your screen and camera as separate layers. Shape the story afterward with layouts, backgrounds and a timeline, then export an MP4. Your project stays editable."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <StackPanel Spacing="14">
                    <local:GuideRow
                        Glyph="&#xF16F;"
                        Title="Give every recording a look"
                        Subtitle="Frame your screen with a background, padding and rounded corners. Move your camera bubble or switch to side by side." />
                    <local:GuideRow
                        Glyph="&#xE8B2;"
                        Title="Keep the good parts"
                        Subtitle="Trim, cut, add zooms and change the layout with scenes. Adjust the volume before you export." />
                    <local:GuideRow
                        Glyph="&#xE8A7;"
                        Title="Export a video. Keep the possibilities."
                        Subtitle="Share an MP4, reopen your project, or save a project folder to carry on editing on another computer." />
                </StackPanel>

                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="10">
                        <ToggleSwitch
                            x:Name="StudioToggle"
                            AutomationProperties.AutomationId="WhatsNewStudioToggle"
                            AutomationProperties.Name="Enable Tiny Clips Studio preview"
                            AutomationProperties.HelpText="Adds Studio to the tray menu. Ordinary video recording is unchanged."
                            Header="Enable Tiny Clips Studio (Preview)"
                            IsOn="{x:Bind ViewModel.IsStudioEnabled, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose Studio in the tray menu when Studio is on to start a Studio recording. Record Video and its hotkey still make ordinary recordings."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Studio is an early preview, now on by default if you haven't saved a preference. Your previous choice is kept. You can turn it off here or in Settings &gt; Studio at any time; your projects are kept."
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="WhatsNewOpenStudioSettingsButton"
                            Click="OnOpenStudioSettingsClicked"
                            Content="Explore Studio settings" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                AutomationProperties.AutomationId="WhatsNewChangelogLink"
                Content="Full changelog"
                NavigateUri="https://github.com/jamesmontemagno/tiny-clips/blob/main/windows/CHANGELOG.md" />
            <Button
                x:Name="DoneButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="WhatsNewDoneButton"
                Click="OnDoneClicked"
                Content="Got it"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
