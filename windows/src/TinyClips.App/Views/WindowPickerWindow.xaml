<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TinyClips.App.WindowPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose a window to capture">

    <Grid
        x:Name="RootGrid"
        AutomationProperties.AutomationId="WindowPickerOverlay"
        AutomationProperties.HelpText="Point at a window and click to capture it. Press Tab to move between windows, Enter to capture, or Escape to cancel."
        AutomationProperties.Name="Choose a window to capture"
        Background="Transparent"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PreviewKeyDown="OnPreviewKeyDown"
        SizeChanged="OnRootSizeChanged">
        <Image x:Name="Backdrop" Stretch="Fill" />
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!--  Uniform dim shown while no window is highlighted  -->
            <Rectangle x:Name="FullDim" Fill="#73000000" />
            <!--  Four dim panels around the highlighted window, leaving it clear  -->
            <Rectangle x:Name="TopDim" Fill="#73000000" Visibility="Collapsed" />
            <Rectangle x:Name="BottomDim" Fill="#73000000" Visibility="Collapsed" />
            <Rectangle x:Name="LeftDim" Fill="#73000000" Visibility="Collapsed" />
            <Rectangle x:Name="RightDim" Fill="#73000000" Visibility="Collapsed" />
            <Border
                x:Name="Highlight"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="3"
                CornerRadius="8"
                Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Opacity="0.12" Color="{ThemeResource SystemAccentColor}" />
                </Border.Background>
            </Border>
            <Border
                x:Name="HoverLabel"
                MaxWidth="440"
                Padding="14,10"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="HoverTitle"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="HoverDetail"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Canvas>
        <Border
            x:Name="HintPill"
            Margin="0,48,0,0"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="HintText"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Click a window to capture · Tab to cycle · Enter to select · Esc to cancel" />
        </Border>
        <TextBlock
            x:Name="AnnouncementAnchor"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="WindowPickerAnnouncement"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</Window>
