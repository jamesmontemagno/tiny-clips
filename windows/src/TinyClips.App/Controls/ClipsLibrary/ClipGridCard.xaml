<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.ClipsLibrary.ClipGridCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App.Controls.ClipsLibrary"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="{x:Bind Item.AutomationName, Mode=OneWay}"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    mc:Ignorable="d">

    <Grid
        x:Name="CardRoot"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Hovered">
                    <VisualState.Setters>
                        <Setter Target="HoverActions.Visibility" Value="Visible" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                        <Setter Target="CardRoot.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Thumbnail  -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            CornerRadius="8,8,0,0">
            <Image
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Source="{x:Bind Item.ThumbnailLazy, Mode=OneWay}"
                Stretch="UniformToFill" />
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="36"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="{x:Bind Item.TypeGlyph, Mode=OneWay}"
                Visibility="{x:Bind local:ClipGridCard.Not(Item.HasThumbnail), Mode=OneWay}" />

            <!--  Type badge (bottom-left)  -->
            <Border
                Margin="8"
                Padding="7,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon FontSize="11" Glyph="{x:Bind Item.TypeGlyph, Mode=OneWay}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Item.TypeLabel, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Favorite star (top-right)  -->
            <FontIcon
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE735;"
                Visibility="{x:Bind Item.IsFavorite, Mode=OneWay}" />

            <!--  Hover actions  -->
            <StackPanel
                x:Name="HoverActions"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed">
                <Button
                    Padding="6"
                    AutomationProperties.AutomationId="{x:Bind local:ClipGridCard.Id(Item, 'Favorite'), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:ClipGridCard.FavoriteLabel(Item.IsFavorite), Mode=OneWay}"
                    Command="{x:Bind Item.Owner.ToggleFavoriteCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind Item, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind local:ClipGridCard.FavoriteLabel(Item.IsFavorite), Mode=OneWay}">
                    <FontIcon FontSize="13" Glyph="{x:Bind local:ClipGridCard.FavoriteGlyph(Item.IsFavorite), Mode=OneWay}" />
                </Button>
                <Button
                    Padding="6"
                    AutomationProperties.AutomationId="{x:Bind local:ClipGridCard.Id(Item, 'Copy'), Mode=OneWay}"
                    AutomationProperties.Name="Copy to clipboard"
                    Command="{x:Bind Item.Owner.CopyCommand, Mode=OneWay}"
                    CommandParameter="{x:Bind Item, Mode=OneWay}"
                    ToolTipService.ToolTip="Copy to clipboard">
                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="MoreButton"
                    Padding="6"
                    AutomationProperties.AutomationId="{x:Bind local:ClipGridCard.Id(Item, 'More'), Mode=OneWay}"
                    AutomationProperties.Name="More clip actions"
                    Click="OnMoreClicked"
                    ToolTipService.ToolTip="More actions">
                    <FontIcon FontSize="13" Glyph="&#xE712;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Metadata  -->
        <StackPanel
            Grid.Row="1"
            Padding="12,10,12,10"
            Spacing="3">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Item.DisplayName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{x:Bind Item.FileName, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Item.MetaLine, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Item.TagsDisplay, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Item.HasTags, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Item.NotesPreview, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind local:ClipGridCard.And(Item.HasNotes, Item.Owner.ShowNotesPreview), Mode=OneWay}" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind local:ClipGridCard.Or(Item.IsUploading, Item.HasUploadedUrl), Mode=OneWay}">
                <ProgressRing
                    Width="12"
                    Height="12"
                    IsActive="{x:Bind Item.IsUploading, Mode=OneWay}"
                    Visibility="{x:Bind Item.IsUploading, Mode=OneWay}" />
                <FontIcon
                    FontSize="11"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE898;"
                    Visibility="{x:Bind local:ClipGridCard.And(Item.HasUploadedUrl, Item.IsUploadIdle), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:ClipGridCard.UploadText(Item.IsUploading, Item.HasUploadedUrl), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
