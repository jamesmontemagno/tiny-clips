<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.ClipsLibrary.ClipDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App.Controls.ClipsLibrary"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AutomationId="ClipDetailPane"
    AutomationProperties.Name="Clip details"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">

        <!--  Placeholder when nothing is selected  -->
        <StackPanel
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:ClipGridCard.Not(ViewModel.HasClip), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="36"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8A1;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Select a clip to preview it" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Edit its name, tags, notes and collection here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Visibility="{x:Bind ViewModel.HasClip, Mode=OneWay}">
            <StackPanel Padding="16,12,16,16" Spacing="14">

                <!--  Media preview  -->
                <Grid
                    MinHeight="160"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <MediaPlayerElement
                        x:Name="Player"
                        MaxHeight="260"
                        AreTransportControlsEnabled="True"
                        AutoPlay="False"
                        AutomationProperties.AutomationId="ClipDetailVideo"
                        Stretch="Uniform"
                        Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                        <MediaPlayerElement.TransportControls>
                            <MediaTransportControls IsCompact="True" IsZoomButtonVisible="False" />
                        </MediaPlayerElement.TransportControls>
                    </MediaPlayerElement>
                    <Image
                        x:Name="Preview"
                        MaxHeight="260"
                        AutomationProperties.AutomationId="ClipDetailImage"
                        AutomationProperties.Name="{x:Bind ViewModel.Clip.DisplayName, Mode=OneWay}"
                        Stretch="Uniform"
                        Visibility="{x:Bind ViewModel.IsImage, Mode=OneWay}" />
                </Grid>

                <!--  Primary actions  -->
                <Grid ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DetailEditButton"
                        AutomationProperties.Name="{x:Bind ViewModel.Clip.EditVerb, Mode=OneWay}"
                        Command="{x:Bind Library.OpenCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Open in editor (Enter)">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.Clip.EditGlyph, Mode=OneWay}" />
                            <TextBlock FontSize="11" Text="{x:Bind ViewModel.Clip.EditVerb, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DetailCopyButton"
                        AutomationProperties.Name="Copy"
                        Command="{x:Bind Library.CopyCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy to clipboard (Ctrl+C)">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock FontSize="11" Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DetailShareButton"
                        AutomationProperties.Name="Share"
                        Command="{x:Bind Library.ShareCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                        ToolTipService.ToolTip="Share">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock FontSize="11" Text="Share" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DetailRevealButton"
                        AutomationProperties.Name="Show in Explorer"
                        Command="{x:Bind Library.RevealCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                        ToolTipService.ToolTip="Show in Explorer">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <FontIcon FontSize="16" Glyph="&#xEC50;" />
                            <TextBlock FontSize="11" Text="Show" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  Favorite + more  -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton
                        AutomationProperties.AutomationId="DetailFavoriteToggle"
                        AutomationProperties.Name="Favorite"
                        Click="OnFavoriteClicked"
                        IsChecked="{x:Bind ViewModel.Clip.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="Toggle favorite">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind local:ClipGridCard.FavoriteGlyph(ViewModel.Clip.IsFavorite), Mode=OneWay}" />
                            <TextBlock Text="Favorite" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.AutomationId="DetailMoreButton"
                        AutomationProperties.Name="More clip actions"
                        Click="OnMoreClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <TextBlock Text="More" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Editable metadata  -->
                <StackPanel Spacing="10">
                    <TextBox
                        AutomationProperties.AutomationId="DetailNameTextBox"
                        Header="Name"
                        PlaceholderText="{x:Bind ViewModel.Clip.FileName, Mode=OneWay}"
                        Text="{x:Bind ViewModel.DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Tags" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <local:WrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border
                                        Padding="8,2,2,2"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind}" />
                                            <Button
                                                Padding="4"
                                                AutomationProperties.Name="Remove tag"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnRemoveTagClicked"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="9" Glyph="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <AutoSuggestBox
                            x:Name="TagBox"
                            AutomationProperties.AutomationId="DetailTagBox"
                            AutomationProperties.Name="Add tag"
                            PlaceholderText="Add a tag and press Enter"
                            QueryIcon="Add"
                            QuerySubmitted="OnTagQuerySubmitted"
                            Text="{x:Bind ViewModel.NewTagText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="OnTagTextChanged" />
                    </StackPanel>

                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DetailCollectionBox"
                        Header="Collection"
                        IsEditable="True"
                        ItemsSource="{x:Bind ViewModel.CollectionSuggestions, Mode=OneWay}"
                        PlaceholderText="None"
                        Text="{x:Bind ViewModel.DraftCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        MinHeight="72"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="DetailNotesTextBox"
                        Header="Notes"
                        PlaceholderText="What is this clip about?"
                        Text="{x:Bind ViewModel.DraftNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            AutomationProperties.AutomationId="DetailRevertButton"
                            Command="{x:Bind ViewModel.RevertCommand, Mode=OneWay}"
                            Content="Revert" />
                        <Button
                            AutomationProperties.AutomationId="DetailSaveButton"
                            Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}"
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!--  Upload link  -->
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Clip.HasUploadedUrl, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Upload link" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Clip.UploadedUrl, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="1"
                            Padding="6"
                            AutomationProperties.AutomationId="DetailCopyLinkButton"
                            AutomationProperties.Name="Copy upload link"
                            Command="{x:Bind Library.CopyLinkCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                            ToolTipService.ToolTip="Copy link">
                            <FontIcon FontSize="13" Glyph="&#xE71B;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Padding="6"
                            AutomationProperties.AutomationId="DetailOpenLinkButton"
                            AutomationProperties.Name="Open upload link"
                            Command="{x:Bind Library.OpenLinkCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.Clip, Mode=OneWay}"
                            ToolTipService.ToolTip="Open link">
                            <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!--  File facts  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="File" />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Type" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Clip.TypeLabel, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Captured" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Clip.DisplayDate, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Size" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Clip.FileSizeDisplay, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Dimensions" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ResolutionDisplay, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Duration" Visibility="{x:Bind ViewModel.HasDuration, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.DurationDisplay, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDuration, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Location" />
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Clip.Path, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
