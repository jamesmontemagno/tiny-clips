<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.ClipsLibrary.LibraryEmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App.Controls.ClipsLibrary"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AutomationId="LibraryEmptyState"
    mc:Ignorable="d">

    <StackPanel
        MaxWidth="360"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="10">
        <ProgressRing
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            IsActive="{x:Bind IsLoading, Mode=OneWay}"
            Visibility="{x:Bind IsLoading, Mode=OneWay}" />
        <FontIcon
            HorizontalAlignment="Center"
            FontSize="44"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Glyph="{x:Bind Glyph, Mode=OneWay}"
            Visibility="{x:Bind local:ClipGridCard.Not(IsLoading), Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextAlignment="Center" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="LibraryEmptyStateAction"
            Command="{x:Bind ActionCommand, Mode=OneWay}"
            Content="{x:Bind ActionText, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind HasAction, Mode=OneWay}" />
    </StackPanel>
</UserControl>
