<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.ScreenshotEditor.EditorToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="8,8,12,8"
        VerticalAlignment="Stretch"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <Border.Resources>
            <!--  Rail tool buttons: zero padding so the glyph is centered in the full
                  44x44 hit target and never clipped at fractional scales (e.g. 125%).  -->
            <Style TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="18" />
            </Style>
        </Border.Resources>
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <ToggleButton
                    x:Name="ToolSelect"
                    AutomationProperties.AutomationId="EditorToolSelect"
                    AutomationProperties.Name="Select and move"
                    Click="OnToolClick"
                    Tag="Select"
                    ToolTipService.ToolTip="Select / Move (V)">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B0;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolCrop"
                    AutomationProperties.AutomationId="EditorToolCrop"
                    AutomationProperties.Name="Crop"
                    Click="OnToolClick"
                    Tag="Crop"
                    ToolTipService.ToolTip="Crop (C)">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7A8;" />
                </ToggleButton>
                <Rectangle
                    Height="1"
                    Margin="4,3"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton
                    x:Name="ToolRectangle"
                    AutomationProperties.AutomationId="EditorToolRectangle"
                    AutomationProperties.Name="Rectangle"
                    Click="OnToolClick"
                    Tag="Rectangle"
                    ToolTipService.ToolTip="Rectangle (R) — hold Shift for square">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71A;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolEllipse"
                    AutomationProperties.AutomationId="EditorToolEllipse"
                    AutomationProperties.Name="Ellipse"
                    Click="OnToolClick"
                    Tag="Ellipse"
                    ToolTipService.ToolTip="Ellipse (O) — hold Shift for circle">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA3A;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolArrow"
                    AutomationProperties.AutomationId="EditorToolArrow"
                    AutomationProperties.Name="Arrow"
                    Click="OnToolClick"
                    Tag="Arrow"
                    ToolTipService.ToolTip="Arrow (A) — drag any direction">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72A;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolLine"
                    AutomationProperties.AutomationId="EditorToolLine"
                    AutomationProperties.Name="Line"
                    Click="OnToolClick"
                    Tag="Line"
                    ToolTipService.ToolTip="Line (L) — hold Shift to snap">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE738;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolPen"
                    AutomationProperties.AutomationId="EditorToolPen"
                    AutomationProperties.Name="Draw"
                    Click="OnToolClick"
                    Tag="Pen"
                    ToolTipService.ToolTip="Draw (D)">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolText"
                    AutomationProperties.AutomationId="EditorToolText"
                    AutomationProperties.Name="Text"
                    Click="OnToolClick"
                    Tag="Text"
                    ToolTipService.ToolTip="Text (T)">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8D2;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolCounter"
                    AutomationProperties.AutomationId="EditorToolCounter"
                    AutomationProperties.Name="Number badge"
                    Click="OnToolClick"
                    Tag="Counter"
                    ToolTipService.ToolTip="Number (N)">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="#" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ToolRedact"
                    AutomationProperties.AutomationId="EditorToolRedact"
                    AutomationProperties.Name="Redact"
                    Click="OnToolClick"
                    Tag="Redact"
                    ToolTipService.ToolTip="Redact / Blur (B)">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED1A;" />
                </ToggleButton>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
