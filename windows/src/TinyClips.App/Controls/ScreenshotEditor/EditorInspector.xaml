<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.ScreenshotEditor.EditorInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:studio="using:TinyClips.App.Controls.Studio"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="EmojiGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="EmojiItemTemplate" x:DataType="x:String">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind}"
                FontFamily="Segoe UI Emoji"
                FontSize="18"
                IsColorFontEnabled="True"
                Text="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Width="252"
        VerticalAlignment="Stretch"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="14" Spacing="14">
                <TextBlock
                    x:Name="InspectorTitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Tool" />

                <StackPanel
                    x:Name="SelectHintSection"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Select an annotation on the canvas to adjust its appearance. Drag inside it to move, or use its handles to resize and rotate."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Crop actions belong with the active Crop tool, not the global command bar.  -->
                <StackPanel
                    x:Name="CropSection"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Drag on the image to select the area to keep."
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ApplyCropButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorApplyCropButton"
                        AutomationProperties.Name="Apply crop"
                        Click="OnApplyCropClick"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Apply the selected crop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7A8;" />
                            <TextBlock Text="Apply crop" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Arrow shape (item order matches ArrowPreset)  -->
                <StackPanel x:Name="ArrowStyleSection" Spacing="4">
                    <TextBlock Text="Arrow" />
                    <studio:StudioSegmented
                        x:Name="ArrowPresetChoice"
                        HorizontalAlignment="Stretch"
                        studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                        AutomationProperties.AutomationId="EditorArrowPresetChoice"
                        AutomationProperties.Name="Arrow shape"
                        SelectionChanged="OnArrowPresetChanged">
                        <controls:SegmentedItem Content="Classic" />
                        <controls:SegmentedItem Content="Tapered" />
                        <controls:SegmentedItem Content="Custom" />
                    </studio:StudioSegmented>
                </StackPanel>

                <!--  Color  -->
                <StackPanel x:Name="ColorSection" Spacing="6">
                    <TextBlock
                        x:Name="ColorLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Color" />
                    <local:SwatchColorPicker
                        x:Name="AnnotationColorPicker"
                        AutomationProperties.AutomationId="EditorColorButton"
                        AutomationProperties.Name="Color"
                        ColorChanged="OnColorChanged"
                        IsAlphaEnabled="False" />
                </StackPanel>

                <!--  Stroke width  -->
                <StackPanel x:Name="StrokeSection" Spacing="2">
                    <Slider
                        x:Name="StrokeSlider"
                        AutomationProperties.AutomationId="EditorStrokeSlider"
                        AutomationProperties.Name="Stroke width"
                        Header="Stroke"
                        Maximum="40"
                        Minimum="1"
                        StepFrequency="1"
                        ValueChanged="OnStrokeChanged" />
                    <Slider
                        x:Name="StrokeOpacitySlider"
                        AutomationProperties.AutomationId="EditorStrokeOpacitySlider"
                        AutomationProperties.Name="Stroke opacity"
                        Header="Stroke opacity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnStrokeOpacityChanged"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  Outline for arrows and lines (their color and width above are the body)  -->
                <StackPanel x:Name="OutlineSection" Spacing="6">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Stroke color" />
                    <local:SwatchColorPicker
                        x:Name="OutlineColorPicker"
                        AutomationProperties.AutomationId="EditorOutlineColorButton"
                        AutomationProperties.Name="Stroke color"
                        ColorChanged="OnOutlineColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="OutlineSlider"
                        AutomationProperties.AutomationId="EditorOutlineSlider"
                        AutomationProperties.Name="Stroke width"
                        Header="Stroke"
                        Maximum="20"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnOutlineWidthChanged" />
                    <Slider
                        x:Name="OutlineOpacitySlider"
                        AutomationProperties.AutomationId="EditorOutlineOpacitySlider"
                        AutomationProperties.Name="Stroke opacity"
                        Header="Stroke opacity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnOutlineOpacityChanged" />
                </StackPanel>

                <!--  Stroke position for closed shapes (item order matches StrokeAlignment)  -->
                <StackPanel x:Name="StrokeAlignmentSection" Spacing="4">
                    <TextBlock Text="Stroke position" />
                    <studio:StudioSegmented
                        x:Name="StrokeAlignmentChoice"
                        HorizontalAlignment="Stretch"
                        studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                        AutomationProperties.AutomationId="EditorStrokeAlignmentChoice"
                        AutomationProperties.Name="Stroke position"
                        SelectionChanged="OnStrokeAlignmentChanged">
                        <controls:SegmentedItem Content="Center" />
                        <controls:SegmentedItem Content="Inside" />
                        <controls:SegmentedItem Content="Outside" />
                    </studio:StudioSegmented>
                </StackPanel>

                <!--  Line ends (item order matches StrokeCap)  -->
                <StackPanel x:Name="StartCapSection" Spacing="4">
                    <TextBlock Text="Start" />
                    <studio:StudioSegmented
                        x:Name="StartCapChoice"
                        HorizontalAlignment="Stretch"
                        studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                        AutomationProperties.AutomationId="EditorStartCapChoice"
                        AutomationProperties.Name="Line start"
                        SelectionChanged="OnStartCapChanged">
                        <controls:SegmentedItem Content="Flat" />
                        <controls:SegmentedItem Content="Round" />
                        <controls:SegmentedItem Content="Square" />
                    </studio:StudioSegmented>
                </StackPanel>
                <StackPanel x:Name="EndCapSection" Spacing="4">
                    <TextBlock Text="End" />
                    <studio:StudioSegmented
                        x:Name="EndCapChoice"
                        HorizontalAlignment="Stretch"
                        studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                        AutomationProperties.AutomationId="EditorEndCapChoice"
                        AutomationProperties.Name="Line end"
                        SelectionChanged="OnEndCapChanged">
                        <controls:SegmentedItem Content="Flat" />
                        <controls:SegmentedItem Content="Round" />
                        <controls:SegmentedItem Content="Square" />
                    </studio:StudioSegmented>
                </StackPanel>

                <!--  Advanced stroke options (item order matches StrokeJoin)  -->
                <Expander
                    x:Name="StrokeAdvancedExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="EditorStrokeAdvancedExpander"
                    Header="Advanced">
                    <Expander.Resources>
                        <Thickness x:Key="ExpanderContentPadding">12,8,12,12</Thickness>
                    </Expander.Resources>
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="ArrowAdvancedPanel" Spacing="8">
                            <Slider
                                x:Name="ArrowArcSlider"
                                AutomationProperties.AutomationId="EditorArrowArcSlider"
                                AutomationProperties.Name="Arc"
                                Header="Arc"
                                Maximum="100"
                                Minimum="-100"
                                StepFrequency="1"
                                ValueChanged="OnArrowSliderChanged" />
                            <Slider
                                x:Name="ArrowStartWidthSlider"
                                AutomationProperties.AutomationId="EditorArrowStartWidthSlider"
                                AutomationProperties.Name="Start width"
                                Header="Start width"
                                Maximum="200"
                                Minimum="0"
                                StepFrequency="1"
                                ValueChanged="OnArrowSliderChanged" />
                            <Slider
                                x:Name="ArrowEndWidthSlider"
                                AutomationProperties.AutomationId="EditorArrowEndWidthSlider"
                                AutomationProperties.Name="End width"
                                Header="End width"
                                Maximum="200"
                                Minimum="0"
                                StepFrequency="1"
                                ValueChanged="OnArrowSliderChanged" />
                            <Slider
                                x:Name="ArrowHeadSizeSlider"
                                AutomationProperties.AutomationId="EditorArrowHeadSizeSlider"
                                AutomationProperties.Name="Head size"
                                Header="Head size"
                                Maximum="300"
                                Minimum="50"
                                StepFrequency="1"
                                ValueChanged="OnArrowSliderChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Corners" />
                            <studio:StudioSegmented
                                x:Name="LineJoinChoice"
                                HorizontalAlignment="Stretch"
                                studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                                AutomationProperties.AutomationId="EditorLineJoinChoice"
                                AutomationProperties.Name="Corners"
                                SelectionChanged="OnLineJoinChanged">
                                <controls:SegmentedItem Content="Sharp" />
                                <controls:SegmentedItem Content="Round" />
                                <controls:SegmentedItem Content="Beveled" />
                            </studio:StudioSegmented>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!--  Fill (rectangle / ellipse)  -->
                <StackPanel x:Name="FillSection" Spacing="6">
                    <CheckBox
                        x:Name="FillCheck"
                        AutomationProperties.AutomationId="EditorFillCheck"
                        AutomationProperties.Name="Fill shape"
                        Checked="OnFillToggled"
                        Content="Fill shape"
                        Unchecked="OnFillToggled" />
                    <local:SwatchColorPicker
                        x:Name="FillColorPicker"
                        AutomationProperties.AutomationId="EditorFillColorButton"
                        AutomationProperties.Name="Fill color"
                        AllowTransparent="True"
                        ColorChanged="OnFillColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="FillOpacitySlider"
                        AutomationProperties.AutomationId="EditorFillOpacitySlider"
                        AutomationProperties.Name="Fill opacity"
                        Header="Fill opacity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnFillOpacityChanged" />
                </StackPanel>

                <!--  Text  -->
                <StackPanel x:Name="TextSection" Spacing="10">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Style" />
                            <TextBlock
                                x:Name="TextStyleCustomLabel"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Custom"
                                Visibility="Collapsed" />
                        </Grid>
                        <studio:StudioSegmented
                            x:Name="TextStyleChoice"
                            HorizontalAlignment="Stretch"
                            studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                            AutomationProperties.AutomationId="EditorTextStyleChoice"
                            AutomationProperties.Name="Text style"
                            SelectionChanged="OnTextPresetChanged">
                            <controls:SegmentedItem Content="Plain" />
                            <controls:SegmentedItem Content="Light" />
                            <controls:SegmentedItem Content="Dark" />
                            <controls:SegmentedItem Content="Accent" />
                        </studio:StudioSegmented>
                    </StackPanel>
                    <ComboBox
                        x:Name="FontFamilyCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorFontFamilyCombo"
                        AutomationProperties.Name="Font"
                        Header="Font"
                        SelectionChanged="OnFontFamilyChanged" />
                    <Slider
                        x:Name="FontSizeSlider"
                        AutomationProperties.AutomationId="EditorFontSizeSlider"
                        AutomationProperties.Name="Font size"
                        Header="Font size"
                        Maximum="200"
                        Minimum="10"
                        StepFrequency="1"
                        ValueChanged="OnFontSizeChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Box" />
                    <local:SwatchColorPicker
                        x:Name="TextBackgroundColorPicker"
                        AutomationProperties.AutomationId="EditorTextBackgroundColorButton"
                        AutomationProperties.Name="Text box background color"
                        AllowTransparent="True"
                        ColorChanged="OnTextBackgroundColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="TextBackgroundOpacitySlider"
                        AutomationProperties.AutomationId="EditorTextBackgroundOpacitySlider"
                        AutomationProperties.Name="Text box background opacity"
                        Header="Background opacity"
                        Maximum="100"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnTextBackgroundOpacityChanged" />
                    <local:SwatchColorPicker
                        x:Name="TextBorderColorPicker"
                        AutomationProperties.AutomationId="EditorTextBorderColorButton"
                        AutomationProperties.Name="Text box border color"
                        AllowTransparent="True"
                        ColorChanged="OnTextBorderColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="TextBorderWidthSlider"
                        AutomationProperties.AutomationId="EditorTextBorderWidthSlider"
                        AutomationProperties.Name="Text box border width"
                        Header="Border width"
                        Maximum="12"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnTextBorderWidthChanged" />
                    <Slider
                        x:Name="TextPaddingSlider"
                        AutomationProperties.AutomationId="EditorTextPaddingSlider"
                        AutomationProperties.Name="Text box padding"
                        Header="Padding"
                        Maximum="48"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnTextPaddingChanged" />
                    <Slider
                        x:Name="TextCornerRadiusSlider"
                        AutomationProperties.AutomationId="EditorTextCornerRadiusSlider"
                        AutomationProperties.Name="Text box corner radius"
                        Header="Corner radius"
                        Maximum="32"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnTextCornerRadiusChanged" />
                </StackPanel>

                <!--  Number badge  -->
                <StackPanel x:Name="CounterSection" Spacing="10">
                    <Slider
                        x:Name="NumberSizeSlider"
                        AutomationProperties.AutomationId="EditorNumberSizeSlider"
                        AutomationProperties.Name="Badge size"
                        Header="Badge size"
                        Maximum="4"
                        Minimum="0.5"
                        StepFrequency="0.25"
                        ValueChanged="OnNumberSizeChanged" />
                    <Slider
                        x:Name="BadgeOpacitySlider"
                        AutomationProperties.AutomationId="EditorBadgeOpacitySlider"
                        AutomationProperties.Name="Badge opacity"
                        Header="Badge opacity"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnBadgeOpacityChanged" />
                    <StackPanel Spacing="6">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Number color" />
                        <local:SwatchColorPicker
                            x:Name="NumberColorPicker"
                            AutomationProperties.AutomationId="EditorNumberColorButton"
                            AutomationProperties.Name="Number color"
                            ColorChanged="OnNumberColorChanged"
                            IsAlphaEnabled="False" />
                    </StackPanel>
                </StackPanel>

                <!--  Pointer (item order matches PointerStyle)  -->
                <StackPanel x:Name="PointerSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pointer" />
                        <studio:StudioSegmented
                            x:Name="PointerStyleChoice"
                            HorizontalAlignment="Stretch"
                            studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                            AutomationProperties.AutomationId="EditorPointerStyleChoice"
                            AutomationProperties.Name="Pointer style"
                            SelectionChanged="OnPointerStyleChanged">
                            <controls:SegmentedItem Content="Arrow" />
                            <controls:SegmentedItem Content="Hand" />
                            <controls:SegmentedItem Content="Text" />
                        </studio:StudioSegmented>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Fill" />
                    <local:SwatchColorPicker
                        x:Name="PointerFillColorPicker"
                        AutomationProperties.AutomationId="EditorPointerFillColorButton"
                        AutomationProperties.Name="Pointer fill color"
                        AllowTransparent="True"
                        ColorChanged="OnPointerFillColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="PointerFillOpacitySlider"
                        AutomationProperties.AutomationId="EditorPointerFillOpacitySlider"
                        AutomationProperties.Name="Fill opacity"
                        Header="Fill opacity"
                        Maximum="100"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnPointerSliderChanged" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Stroke" />
                    <local:SwatchColorPicker
                        x:Name="PointerStrokeColorPicker"
                        AutomationProperties.AutomationId="EditorPointerStrokeColorButton"
                        AutomationProperties.Name="Pointer stroke color"
                        AllowTransparent="True"
                        ColorChanged="OnPointerStrokeColorChanged"
                        IsAlphaEnabled="True" />
                    <Slider
                        x:Name="PointerStrokeOpacitySlider"
                        AutomationProperties.AutomationId="EditorPointerStrokeOpacitySlider"
                        AutomationProperties.Name="Stroke opacity"
                        Header="Stroke opacity"
                        Maximum="100"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnPointerSliderChanged" />
                    <Slider
                        x:Name="PointerStrokeWidthSlider"
                        AutomationProperties.AutomationId="EditorPointerStrokeWidthSlider"
                        AutomationProperties.Name="Stroke width"
                        Header="Stroke width"
                        Maximum="20"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnPointerSliderChanged" />
                    <Slider
                        x:Name="PointerOpacitySlider"
                        AutomationProperties.AutomationId="EditorPointerOpacitySlider"
                        AutomationProperties.Name="Opacity"
                        Header="Opacity"
                        Maximum="100"
                        Minimum="0"
                        PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                        PointerPressed="OnTextStyleSliderPointerPressed"
                        PointerReleased="OnTextStyleSliderPointerReleased"
                        StepFrequency="1"
                        ValueChanged="OnPointerSliderChanged" />
                    <Expander
                        x:Name="PointerShadowExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorPointerShadowExpander"
                        AutomationProperties.Name="Drop shadow"
                        Header="Drop shadow">
                        <Expander.Resources>
                            <Thickness x:Key="ExpanderContentPadding">12,8,12,12</Thickness>
                        </Expander.Resources>
                        <StackPanel Spacing="8">
                            <CheckBox
                                x:Name="PointerShadowCheck"
                                AutomationProperties.AutomationId="EditorPointerShadowCheck"
                                AutomationProperties.Name="Show shadow"
                                Checked="OnPointerShadowToggled"
                                Content="Show shadow"
                                Unchecked="OnPointerShadowToggled" />
                            <StackPanel x:Name="PointerShadowControls" Spacing="2">
                            <Slider
                                x:Name="PointerShadowOpacitySlider"
                                AutomationProperties.AutomationId="EditorPointerShadowOpacitySlider"
                                AutomationProperties.Name="Shadow opacity"
                                Header="Shadow opacity"
                                Maximum="100"
                                Minimum="0"
                                PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                                PointerPressed="OnTextStyleSliderPointerPressed"
                                PointerReleased="OnTextStyleSliderPointerReleased"
                                StepFrequency="1"
                                ValueChanged="OnPointerSliderChanged" />
                            <Slider
                                x:Name="PointerShadowBlurSlider"
                                AutomationProperties.AutomationId="EditorPointerShadowBlurSlider"
                                AutomationProperties.Name="Blur"
                                Header="Blur"
                                Maximum="40"
                                Minimum="0"
                                PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                                PointerPressed="OnTextStyleSliderPointerPressed"
                                PointerReleased="OnTextStyleSliderPointerReleased"
                                StepFrequency="1"
                                ValueChanged="OnPointerSliderChanged" />
                            <Slider
                                x:Name="PointerShadowOffsetXSlider"
                                AutomationProperties.AutomationId="EditorPointerShadowOffsetXSlider"
                                AutomationProperties.Name="Horizontal offset"
                                Header="Horizontal offset"
                                Maximum="40"
                                Minimum="-40"
                                PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                                PointerPressed="OnTextStyleSliderPointerPressed"
                                PointerReleased="OnTextStyleSliderPointerReleased"
                                StepFrequency="1"
                                ValueChanged="OnPointerSliderChanged" />
                            <Slider
                                x:Name="PointerShadowOffsetYSlider"
                                AutomationProperties.AutomationId="EditorPointerShadowOffsetYSlider"
                                AutomationProperties.Name="Vertical offset"
                                Header="Vertical offset"
                                Maximum="40"
                                Minimum="-40"
                                PointerCaptureLost="OnTextStyleSliderPointerCaptureLost"
                                PointerPressed="OnTextStyleSliderPointerPressed"
                                PointerReleased="OnTextStyleSliderPointerReleased"
                                StepFrequency="1"
                                ValueChanged="OnPointerSliderChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Button
                        x:Name="PointerPlaceAtCenterButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorPointerPlaceAtCenter"
                        AutomationProperties.HelpText="Adds a pointer at the center and selects it for adjustment."
                        AutomationProperties.Name="Place pointer at center"
                        Click="OnPointerPlaceAtCenterClick"
                        Content="Place pointer at center" />
                    <StackPanel x:Name="PointerAdjustPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Nudge and resize" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="PointerNudgeLeftButton"
                                AutomationProperties.AutomationId="EditorPointerNudgeLeft"
                                AutomationProperties.Name="Move pointer left"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Move left">
                                <FontIcon FontSize="14" Glyph="&#xE72B;" />
                            </Button>
                            <Button
                                x:Name="PointerNudgeRightButton"
                                AutomationProperties.AutomationId="EditorPointerNudgeRight"
                                AutomationProperties.Name="Move pointer right"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Move right">
                                <FontIcon FontSize="14" Glyph="&#xE72A;" />
                            </Button>
                            <Button
                                x:Name="PointerNudgeUpButton"
                                AutomationProperties.AutomationId="EditorPointerNudgeUp"
                                AutomationProperties.Name="Move pointer up"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Move up">
                                <FontIcon FontSize="14" Glyph="&#xE74A;" />
                            </Button>
                            <Button
                                x:Name="PointerNudgeDownButton"
                                AutomationProperties.AutomationId="EditorPointerNudgeDown"
                                AutomationProperties.Name="Move pointer down"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Move down">
                                <FontIcon FontSize="14" Glyph="&#xE74B;" />
                            </Button>
                            <Button
                                x:Name="PointerSmallerButton"
                                AutomationProperties.AutomationId="EditorPointerSmaller"
                                AutomationProperties.Name="Make pointer smaller"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Smaller">
                                <FontIcon FontSize="14" Glyph="&#xE738;" />
                            </Button>
                            <Button
                                x:Name="PointerLargerButton"
                                AutomationProperties.AutomationId="EditorPointerLarger"
                                AutomationProperties.Name="Make pointer larger"
                                Click="OnPointerAdjustClick"
                                ToolTipService.ToolTip="Larger">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Rotation (selected rotatable annotation)  -->
                <StackPanel x:Name="RotationSection" Spacing="2" Visibility="Collapsed">
                    <Slider
                        x:Name="RotationSlider"
                        AutomationProperties.AutomationId="EditorRotationSlider"
                        AutomationProperties.Name="Rotation"
                        Header="Rotation"
                        Maximum="180"
                        Minimum="-180"
                        StepFrequency="1"
                        ValueChanged="OnRotationChanged" />
                </StackPanel>

                <!--  Emoji sticker  -->
                <StackPanel x:Name="EmojiSection" Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Opacity="0.9">
                            <TextBlock
                                x:Name="SelectedEmojiText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EditorSelectedEmoji"
                                AutomationProperties.Name="Selected emoji"
                                FontFamily="Segoe UI Emoji"
                                FontSize="26"
                                IsColorFontEnabled="True"
                                IsTextSelectionEnabled="False" />
                        </Border>
                        <TextBox
                            x:Name="CustomEmojiBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="EditorCustomEmojiBox"
                            AutomationProperties.Name="Custom emoji"
                            PlaceholderText="Type or paste"
                            TextChanged="OnCustomEmojiTextChanged"
                            ToolTipService.ToolTip="Type or paste any emoji, or open the Windows emoji panel." />
                        <Button
                            x:Name="OpenEmojiPanelButton"
                            Grid.Column="2"
                            Width="36"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="EditorOpenEmojiPanel"
                            AutomationProperties.Name="Open emoji panel"
                            Click="OnOpenEmojiPanelClick"
                            ToolTipService.ToolTip="Open the Windows emoji panel (Win+.)">
                            <FontIcon FontSize="16" Glyph="&#xE76E;" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="RecentEmojiPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Recent" />
                        <GridView
                            x:Name="RecentEmojiGrid"
                            Padding="0"
                            AutomationProperties.Name="Recent emoji"
                            IsItemClickEnabled="True"
                            ItemClick="OnEmojiItemClick"
                            ItemContainerStyle="{StaticResource EmojiGridItemStyle}"
                            ItemTemplate="{StaticResource EmojiItemTemplate}"
                            SelectionMode="None" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Common" />
                        <GridView
                            x:Name="CommonEmojiGrid"
                            Padding="0"
                            AutomationProperties.Name="Common emoji"
                            IsItemClickEnabled="True"
                            ItemClick="OnEmojiItemClick"
                            ItemContainerStyle="{StaticResource EmojiGridItemStyle}"
                            ItemTemplate="{StaticResource EmojiItemTemplate}"
                            SelectionMode="None" />
                    </StackPanel>
                </StackPanel>

                <!--  Redaction style + strength  -->
                <StackPanel x:Name="RedactSection" Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Style" />
                        <studio:StudioSegmented
                            x:Name="RedactStyleChoice"
                            HorizontalAlignment="Stretch"
                            studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                            AutomationProperties.AutomationId="EditorRedactStyleChoice"
                            AutomationProperties.Name="Redaction style"
                            SelectionChanged="OnRedactionStyleChanged">
                            <controls:SegmentedItem Content="Blur" />
                            <controls:SegmentedItem Content="Pixelate" />
                            <controls:SegmentedItem Content="Solid" />
                        </studio:StudioSegmented>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Strength" />
                        <studio:StudioSegmented
                            x:Name="RedactionChoice"
                            HorizontalAlignment="Stretch"
                            studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                            AutomationProperties.AutomationId="EditorRedactionChoice"
                            AutomationProperties.Name="Redaction strength"
                            SelectionChanged="OnRedactionLevelChanged">
                            <controls:SegmentedItem Content="Light" />
                            <controls:SegmentedItem Content="Medium" />
                            <controls:SegmentedItem Content="Heavy" />
                        </studio:StudioSegmented>
                    </StackPanel>
                </StackPanel>

                <!--  On-device OCR suggestions; shown only while the Redact tool is active.  -->
                <StackPanel x:Name="SensitiveTextSection" Spacing="6" Visibility="Collapsed">
                    <Button
                        x:Name="FindSensitiveTextButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorFindSensitiveTextButton"
                        AutomationProperties.HelpText="Find likely email addresses, phone numbers and IP addresses locally. Does not change the image until you apply."
                        Click="OnFindSensitiveTextClick"
                        ToolTipService.ToolTip="Find likely email addresses, phone numbers and IP addresses locally">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                            <TextBlock Text="Find sensitive text" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Processed on this device. Suggestions may miss sensitive text; review before sharing."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Background &amp; padding; shown only while the Background tool is active.  -->
                <StackPanel
                    x:Name="BackgroundSection"
                    HorizontalAlignment="Stretch"
                    Spacing="12"
                    Visibility="Collapsed">
                    <ComboBox
                        x:Name="BgStyleCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="EditorBgStyleCombo"
                        AutomationProperties.Name="Background style"
                        Header="Style"
                        SelectionChanged="OnBgStyleChanged">
                        <ComboBoxItem Content="Transparent" Tag="Transparent" />
                        <ComboBoxItem Content="Solid color" Tag="Solid" />
                        <ComboBoxItem Content="Gradient" Tag="Gradient" />
                        <ComboBoxItem Content="Image" Tag="Image" />
                    </ComboBox>

                    <StackPanel x:Name="BackgroundImagePanel" Spacing="8" Visibility="Collapsed">
                        <Button
                            x:Name="ChooseBackgroundImageButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="EditorChooseBackgroundImageButton"
                            AutomationProperties.Name="Choose or replace background image"
                            Click="OnChooseBackgroundImage"
                            Content="Choose image..." />
                        <TextBlock
                            x:Name="BackgroundImageName"
                            AutomationProperties.AutomationId="EditorBackgroundImageName"
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Placement" />
                            <studio:StudioSegmented
                                x:Name="BackgroundImagePlacementChoice"
                                HorizontalAlignment="Stretch"
                                studio:StudioSegmentedChoice.KeepsLatestChoice="True"
                                AutomationProperties.AutomationId="EditorBackgroundImagePlacementChoice"
                                AutomationProperties.Name="Background image placement"
                                SelectionChanged="OnBackgroundImagePlacementChanged">
                                <controls:SegmentedItem Content="Fill" />
                                <controls:SegmentedItem Content="Fit" />
                            </studio:StudioSegmented>
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Fill crops to cover the frame. Fit shows the whole image with transparent gaps. Still PNG, JPEG, or WebP; up to 32 megapixels."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="RemoveBackgroundImageButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="EditorRemoveBackgroundImageButton"
                            AutomationProperties.Name="Remove background image"
                            Click="OnRemoveBackgroundImage"
                            Content="Remove image" />
                    </StackPanel>

                    <TextBlock
                        x:Name="SolidPresetHeader"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Solid presets" />
                    <GridView
                        x:Name="SolidPresetGrid"
                        Padding="0"
                        AutomationProperties.Name="Solid background presets"
                        SelectionMode="None" />

                    <TextBlock
                        x:Name="GradientPresetHeader"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Gradient presets" />
                    <GridView
                        x:Name="GradientPresetGrid"
                        Padding="0"
                        AutomationProperties.Name="Gradient background presets"
                        SelectionMode="None" />

                    <Slider
                        x:Name="GradientDirectionSlider"
                        AutomationProperties.AutomationId="EditorGradientDirectionSlider"
                        AutomationProperties.Name="Gradient direction"
                        Header="Gradient direction"
                        Maximum="360"
                        Minimum="0"
                        StepFrequency="1"
                        ToolTipService.ToolTip="Direction from the first color to the second. 0° is left to right; 90° is top to bottom."
                        ValueChanged="OnGradientDirectionChanged" />

                    <StackPanel x:Name="CustomColorPanel" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Custom color" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="EditorCustomSolidBgColorButton"
                            AutomationProperties.Name="Choose custom solid background color"
                            Click="OnChooseCustomSolidColor">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    x:Name="CustomSolidColorSwatch"
                                    Width="22"
                                    Height="22"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <TextBlock VerticalAlignment="Center" Text="Choose color…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="CustomGradientColorPanel" Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Custom gradient colors" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="EditorGradientStartColorButton"
                            AutomationProperties.Name="Choose first gradient color"
                            Click="OnChooseGradientStartColor">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    x:Name="GradientStartColorSwatch"
                                    Width="22"
                                    Height="22"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <TextBlock VerticalAlignment="Center" Text="First color…" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="EditorGradientEndColorButton"
                            AutomationProperties.Name="Choose second gradient color"
                            Click="OnChooseGradientEndColor">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    x:Name="GradientEndColorSwatch"
                                    Width="22"
                                    Height="22"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <TextBlock VerticalAlignment="Center" Text="Second color…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Slider
                        x:Name="PaddingSlider"
                        AutomationProperties.AutomationId="EditorPaddingSlider"
                        AutomationProperties.Name="Padding"
                        Header="Padding"
                        Maximum="160"
                        Minimum="0"
                        StepFrequency="2"
                        ValueChanged="OnPaddingChanged" />
                    <ComboBox
                        x:Name="ExportFrameCombo"
                        AutomationProperties.AutomationId="EditorExportFrameCombo"
                        AutomationProperties.Name="Export frame"
                        Header="Frame"
                        SelectionChanged="OnExportFrameChanged">
                        <ComboBoxItem Content="Original" />
                        <ComboBoxItem Content="1:1" />
                        <ComboBoxItem Content="4:3" />
                        <ComboBoxItem Content="16:9" />
                        <ComboBoxItem Content="3:4" />
                        <ComboBoxItem Content="9:16" />
                    </ComboBox>
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="AlignmentHeader"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Image alignment" />
                        <!--
                            3×3 placement grid: one tap sets both axes. Each cell is a ToggleButton
                            whose checked state mirrors the controller's H+V alignment; arrow keys
                            move between cells, Space/Enter selects.
                        -->
                        <Grid
                            x:Name="AlignmentGrid"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Image alignment"
                            ColumnSpacing="4"
                            RowSpacing="4"
                            XYFocusKeyboardNavigation="Enabled">
                            <Grid.Resources>
                                <Style x:Key="AlignmentCellStyle" TargetType="ToggleButton">
                                    <Setter Property="Width" Value="40" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <!--  A glyph (not a shape) so the dot inherits the cell's state foreground.  -->
                                <Style x:Key="AlignmentDotStyle" TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25CF;" />
                                    <Setter Property="FontSize" Value="10" />
                                    <Setter Property="IsTextSelectionEnabled" Value="False" />
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource AlignmentCellStyle}" Tag="0,0" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignTopLeft" AutomationProperties.Name="Top-left image alignment" ToolTipService.ToolTip="Top left"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource AlignmentCellStyle}" Tag="1,0" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignTopCenter" AutomationProperties.Name="Top-center image alignment" ToolTipService.ToolTip="Top center"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource AlignmentCellStyle}" Tag="2,0" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignTopRight" AutomationProperties.Name="Top-right image alignment" ToolTipService.ToolTip="Top right"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="1" Grid.Column="0" Style="{StaticResource AlignmentCellStyle}" Tag="0,1" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignMiddleLeft" AutomationProperties.Name="Middle-left image alignment" ToolTipService.ToolTip="Middle left"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource AlignmentCellStyle}" Tag="1,1" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignCenter" AutomationProperties.Name="Center image alignment" ToolTipService.ToolTip="Center"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="1" Grid.Column="2" Style="{StaticResource AlignmentCellStyle}" Tag="2,1" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignMiddleRight" AutomationProperties.Name="Middle-right image alignment" ToolTipService.ToolTip="Middle right"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="2" Grid.Column="0" Style="{StaticResource AlignmentCellStyle}" Tag="0,2" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignBottomLeft" AutomationProperties.Name="Bottom-left image alignment" ToolTipService.ToolTip="Bottom left"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="2" Grid.Column="1" Style="{StaticResource AlignmentCellStyle}" Tag="1,2" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignBottomCenter" AutomationProperties.Name="Bottom-center image alignment" ToolTipService.ToolTip="Bottom center"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                            <ToggleButton Grid.Row="2" Grid.Column="2" Style="{StaticResource AlignmentCellStyle}" Tag="2,2" Click="OnAlignmentCellClicked" AutomationProperties.AutomationId="EditorAlignBottomRight" AutomationProperties.Name="Bottom-right image alignment" ToolTipService.ToolTip="Bottom right"><TextBlock Style="{StaticResource AlignmentDotStyle}" /></ToggleButton>
                        </Grid>
                    </StackPanel>
                    <Slider
                        x:Name="CornerSlider"
                        AutomationProperties.AutomationId="EditorCornerSlider"
                        AutomationProperties.Name="Corner radius"
                        Header="Image corners"
                        Maximum="60"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnCornerChanged" />
                    <Slider
                        x:Name="ShadowSlider"
                        AutomationProperties.AutomationId="EditorShadowSlider"
                        AutomationProperties.Name="Shadow"
                        Header="Shadow"
                        Maximum="40"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnShadowChanged" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
