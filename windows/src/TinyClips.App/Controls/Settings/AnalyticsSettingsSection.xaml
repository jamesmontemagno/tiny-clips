<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.AnalyticsSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:sections="using:TinyClips.App.Settings.Sections"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="8">
        <TextBlock
            Margin="4,8,0,4"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Analytics" />

        <InfoBar
            IsOpen="{x:Bind sections:AnalyticsSettingsSection.HasError(ViewModel.AnalyticsLoadError), Mode=OneWay}"
            Message="{x:Bind ViewModel.AnalyticsLoadError, Mode=OneWay}"
            Severity="Warning"
            IsClosable="False" />

        <TextBlock
            Margin="4,4,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Capture history" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Daily captures" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Screenshots, videos, and GIFs taken on this device during the selected range." />

                        <ComboBox
                            Grid.Column="1"
                            Width="150"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="AnalyticsRangeComboBox"
                            AutomationProperties.Name="Analytics range"
                            SelectedIndex="{x:Bind ViewModel.AnalyticsRangeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Last 7 days" />
                            <ComboBoxItem Content="Last 30 days" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowScreenshotsInChartCheckBox"
                            Content="Screenshots"
                            IsChecked="{x:Bind ViewModel.ShowScreenshotsInChart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource SystemFillColorCriticalBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowVideosInChartCheckBox"
                            Content="Videos"
                            IsChecked="{x:Bind ViewModel.ShowVideosInChart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource SystemFillColorSuccessBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowGifsInChartCheckBox"
                            Content="GIFs"
                            IsChecked="{x:Bind ViewModel.ShowGifsInChart, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AnalyticsDays, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CaptureAnalyticsDayViewModel">
                                <StackPanel
                                    Width="24"
                                    Spacing="8"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="{x:Bind AccessibilitySummary}"
                                    ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                    <Grid
                                        Height="160"
                                        VerticalAlignment="Bottom">
                                        <StackPanel
                                            VerticalAlignment="Bottom"
                                            Spacing="0">
                                            <Border
                                                Height="{x:Bind GifHeight}"
                                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                CornerRadius="2,2,0,0" />
                                            <Border
                                                Height="{x:Bind VideoHeight}"
                                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                CornerRadius="2,2,0,0" />
                                            <Border
                                                Height="{x:Bind ScreenshotHeight}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="2,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DateLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Counts are stored locally and automatically roll over after 30 days." />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No captures yet for this range. Take a screenshot, video, or GIF to start the chart."
                    Visibility="{x:Bind ViewModel.AnalyticsEmptyStateVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Totals" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Screenshots" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsScreenshotTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Videos" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsVideoTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="GIFs" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsGifTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Lifetime totals" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Screenshots" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeScreenshotTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Videos" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeVideoTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="GIFs" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeGifTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.LifetimeCaptureTotal, Mode=OneWay}" />
                    <Run Text="captures since you started using Tiny Clips." />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Insights" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Busiest day (selected range)" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.BusiestWeekdayLabel, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WeekdayBreakdown, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:WeekdayBreakdownViewModel">
                                <StackPanel
                                    Width="32"
                                    Spacing="4"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="{x:Bind AccessibilitySummary}"
                                    ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                    <Grid Height="60" VerticalAlignment="Bottom">
                                        <Border
                                            Height="{x:Bind Height}"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="2,2,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="{x:Bind BarOpacity}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DayLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Most active hour (all-time)" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.MostActiveHourLabel, Mode=OneWay}" />
                    <ScrollViewer
                        HorizontalScrollMode="Auto"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HourlyBreakdown, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:HourBreakdownViewModel">
                                    <StackPanel
                                        Width="16"
                                        Spacing="4"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="{x:Bind AccessibilitySummary}"
                                        ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                        <Grid Height="60" VerticalAlignment="Bottom">
                                            <Border
                                                Height="{x:Bind Height}"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="1,1,0,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="{x:Bind BarOpacity}" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Share" />

        <controls:SettingsCard
            Description="Copy or share a quick text summary of your capture activity for the selected range."
            Header="Share analytics"
            HeaderIcon="{ui:FontIcon Glyph=&#xE72D;}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CopyAnalyticsSummaryButton"
                    AutomationProperties.AutomationId="CopyAnalyticsSummaryButton"
                    Click="OnCopyAnalyticsSummary"
                    Content="Copy summary" />
                <Button
                    AutomationProperties.AutomationId="ShareAnalyticsSummaryButton"
                    AutomationProperties.Name="Share analytics summary"
                    Click="OnShareAnalyticsSummary"
                    Content="Share" />
            </StackPanel>
        </controls:SettingsCard>

        <HyperlinkButton
            Margin="0,8,4,0"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="ResetAnalyticsButton"
            Click="OnResetAnalytics"
            Content="Reset capture analytics…" />
        </StackPanel>
    </Border>
</UserControl>
