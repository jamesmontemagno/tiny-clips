<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.AnalyticsSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App"
    xmlns:sections="using:TinyClips.App.Settings.Sections"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AnalyticsBarStyle" TargetType="ListViewItem">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="AnalyticsChartStyle" TargetType="ListView">
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AnalyticsBarStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <sections:AnalyticsChartPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="8">
        <TextBlock
            Margin="4,8,0,4"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Analytics" />

        <InfoBar
            IsOpen="{x:Bind sections:AnalyticsSettingsSection.HasError(ViewModel.AnalyticsLoadError), Mode=OneWay}"
            Message="{x:Bind ViewModel.AnalyticsLoadError, Mode=OneWay}"
            Severity="Warning"
            IsClosable="False" />

        <TextBlock
            Margin="4,4,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Capture history" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Daily captures" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Screenshots, videos, and GIFs taken on this device."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        Width="150"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AnalyticsRangeComboBox"
                        AutomationProperties.Name="Analytics range"
                        SelectedIndex="{x:Bind ViewModel.AnalyticsRangeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Last 7 days" />
                        <ComboBoxItem Content="Last 30 days" />
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowScreenshotsInChartCheckBox"
                            Content="Screenshots"
                            IsChecked="{x:Bind ViewModel.ShowScreenshotsInChart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource SystemFillColorCriticalBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowVideosInChartCheckBox"
                            Content="Videos"
                            IsChecked="{x:Bind ViewModel.ShowVideosInChart, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{ThemeResource SystemFillColorSuccessBrush}" />
                        <CheckBox
                            AutomationProperties.AutomationId="ShowGifsInChartCheckBox"
                            Content="GIFs"
                            IsChecked="{x:Bind ViewModel.ShowGifsInChart, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.AnalyticsChartScaleLabel, Mode=OneWay}" />

                <sections:AnalyticsChart
                    Style="{StaticResource AnalyticsChartStyle}"
                    AutomationProperties.AutomationId="DailyCapturesChart"
                    AutomationProperties.Name="Daily captures"
                    AutomationProperties.HelpText="Select a bar for details. Use Left and Right arrows, Home, or End to explore days."
                    ItemsSource="{x:Bind ViewModel.AnalyticsDays, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAnalyticsDay, Mode=TwoWay}">
                    <sections:AnalyticsChart.ItemTemplate>
                        <DataTemplate x:DataType="local:CaptureAnalyticsDayViewModel">
                            <StackPanel
                                Margin="3,4"
                                Spacing="8"
                                ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                <Grid Height="200">
                                    <Border
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel VerticalAlignment="Bottom" Spacing="0">
                                        <Border
                                            Height="{x:Bind GifHeight}"
                                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                                            CornerRadius="2,2,0,0" />
                                        <Border
                                            Height="{x:Bind VideoHeight}"
                                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                                            CornerRadius="2,2,0,0" />
                                        <Border
                                            Height="{x:Bind ScreenshotHeight}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="2,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DateLabel}" />
                            </StackPanel>
                        </DataTemplate>
                    </sections:AnalyticsChart.ItemTemplate>
                </sections:AnalyticsChart>

                <Border
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="6">
                    <TextBlock
                        AutomationProperties.AutomationId="DailyCaptureDetails"
                        Text="{x:Bind ViewModel.SelectedAnalyticsDaySummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Border>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Select a bar for details, or use the arrow keys while the chart is focused. Type filters change the chart only; totals and details include all types."
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Daily history stays on this device for 30 days. Lifetime and hourly totals are kept until reset."
                    TextWrapping="Wrap" />

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No captures yet for this range. Take a screenshot, video, or GIF to start the chart."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.AnalyticsEmptyStateVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Totals" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Screenshots" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsScreenshotTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Videos" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsVideoTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="GIFs" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AnalyticsGifTotal, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Lifetime totals" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Screenshots" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeScreenshotTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Videos" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeVideoTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="GIFs" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.LifetimeGifTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.LifetimeCaptureTotal, Mode=OneWay}" />
                    <Run Text="captures since you started using Tiny Clips." />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Insights" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Busiest day (selected range)" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.BusiestWeekdayLabel, Mode=OneWay}" />
                    <sections:AnalyticsChart
                        Style="{StaticResource AnalyticsChartStyle}"
                        AutomationProperties.AutomationId="WeekdayCapturesChart"
                        AutomationProperties.Name="Captures by weekday for the selected range"
                        AutomationProperties.HelpText="Select a bar for details. Use Left and Right arrows, Home, or End to explore weekdays."
                        ItemsSource="{x:Bind ViewModel.WeekdayBreakdown, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedWeekday, Mode=TwoWay}">
                        <sections:AnalyticsChart.ItemTemplate>
                            <DataTemplate x:DataType="local:WeekdayBreakdownViewModel">
                                <StackPanel
                                    Margin="3,4"
                                    Spacing="8"
                                    ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                    <Grid Height="100">
                                        <Border
                                            Height="1"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Border
                                            Height="{x:Bind Height}"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="2,2,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="{x:Bind BarOpacity}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DayLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </sections:AnalyticsChart.ItemTemplate>
                    </sections:AnalyticsChart>
                    <TextBlock
                        Margin="4,8,4,0"
                        AutomationProperties.AutomationId="WeekdayCaptureDetails"
                        Text="{x:Bind ViewModel.SelectedWeekdaySummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Most active hour (all-time)" />
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.MostActiveHourLabel, Mode=OneWay}" />
                    <sections:AnalyticsChart
                        Style="{StaticResource AnalyticsChartStyle}"
                        AutomationProperties.AutomationId="HourlyCapturesChart"
                        AutomationProperties.Name="All-time captures by local hour"
                        AutomationProperties.HelpText="Select a bar for details. Use Left and Right arrows, Home, or End to explore hours."
                        ItemsSource="{x:Bind ViewModel.HourlyBreakdown, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedHour, Mode=TwoWay}">
                        <sections:AnalyticsChart.ItemTemplate>
                            <DataTemplate x:DataType="local:HourBreakdownViewModel">
                                <StackPanel
                                    Margin="3,4"
                                    Spacing="8"
                                    ToolTipService.ToolTip="{x:Bind AccessibilitySummary}">
                                    <Grid Height="100">
                                        <Border
                                            Height="1"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Border
                                            Height="{x:Bind Height}"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="1,1,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="{x:Bind BarOpacity}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind AxisLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </sections:AnalyticsChart.ItemTemplate>
                    </sections:AnalyticsChart>
                    <TextBlock
                        Margin="4,8,4,0"
                        AutomationProperties.AutomationId="HourlyCaptureDetails"
                        Text="{x:Bind ViewModel.SelectedHourSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="4,4,4,0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Hours in local time (00-23). Includes all capture types, all-time."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Margin="4,16,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="Share" />

        <controls:SettingsCard
            Description="Copy or share a quick text summary of your capture activity for the selected range."
            Header="Share analytics"
            HeaderIcon="{ui:FontIcon Glyph=&#xE72D;}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CopyAnalyticsSummaryButton"
                    AutomationProperties.AutomationId="CopyAnalyticsSummaryButton"
                    Click="OnCopyAnalyticsSummary"
                    Content="Copy summary" />
                <Button
                    AutomationProperties.AutomationId="ShareAnalyticsSummaryButton"
                    AutomationProperties.Name="Share analytics summary"
                    Click="OnShareAnalyticsSummary"
                    Content="Share" />
            </StackPanel>
        </controls:SettingsCard>

        <HyperlinkButton
            Margin="0,8,4,0"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="ResetAnalyticsButton"
            Click="OnResetAnalytics"
            Content="Reset capture analytics…" />
        </StackPanel>
    </Border>
</UserControl>
