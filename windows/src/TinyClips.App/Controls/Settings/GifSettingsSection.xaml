<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.GifSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                Margin="4,8,0,4"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="GIF" />

            <TextBlock
                Margin="4,4,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="GIF quality" />

            <controls:SettingsExpander
                Header="GIF quality"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8B9;}"
                IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Frame rate">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="GifFrameRateNumberBox"
                            AutomationProperties.Name="GIF frame rate"
                            Maximum="50"
                            Minimum="5"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.GifFrameRate, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Maximum width in pixels">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="GifMaxWidthNumberBox"
                            AutomationProperties.Name="GIF maximum width"
                            Maximum="1920"
                            Minimum="240"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.GifMaxWidth, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock
                Margin="4,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Recording &amp; output" />

            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Choose Region, Screen, or Window before recording."
                    Header="Show capture picker before recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE722;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowGifCapturePickerToggle"
                        AutomationProperties.Name="Show capture picker before GIF recording"
                        IsOn="{x:Bind ViewModel.ShowGifCapturePicker, Mode=TwoWay}" />
                </controls:SettingsCard>


                <controls:SettingsCard
                    Description="Start another GIF recording with the same picker after saving."
                    Header="Show capture picker after recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowGifCapturePickerAfterCaptureToggle"
                        AutomationProperties.Name="Show capture picker after GIF recording"
                        IsEnabled="{x:Bind ViewModel.GifCapturePickerAfterCaptureEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.ShowGifCapturePickerAfterCapture, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Countdown before recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="GifCountdownDurationNumberBox"
                            AutomationProperties.Name="GIF countdown seconds"
                            IsEnabled="{x:Bind ViewModel.GifCountdownEnabled, Mode=OneWay}"
                            Maximum="10"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.GifCountdownDuration, Mode=TwoWay}" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="GifCountdownToggle"
                            AutomationProperties.Name="Enable GIF countdown"
                            IsOn="{x:Bind ViewModel.GifCountdownEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Drop frames from the start and end before saving."
                    Header="Open trimmer after recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE70F;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowGifTrimmerToggle"
                        AutomationProperties.Name="Open GIF trimmer after recording"
                        IsOn="{x:Bind ViewModel.ShowGifTrimmer, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Copy the recorded GIF file so it can be pasted into chats and editors."
                    Header="Copy GIF to the clipboard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="CopyGifToggle"
                        AutomationProperties.Name="Copy GIF to the clipboard"
                        IsOn="{x:Bind ViewModel.CopyGifToClipboard, Mode=TwoWay}" />
                </controls:SettingsCard>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
