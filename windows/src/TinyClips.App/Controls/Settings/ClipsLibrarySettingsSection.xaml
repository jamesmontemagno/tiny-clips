<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.ClipsLibrarySettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <StackPanel Margin="4,8,4,12" Spacing="2">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Clips Library" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Choose how the Library opens, what each clip shows, and how it manages older captures."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Margin="4,8,4,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Defaults" />
            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Reopen the Library exactly where you left it (view, sort, filters, collection)."
                    Header="Remember last state"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryRememberStateToggle"
                        AutomationProperties.Name="Remember last state"
                        IsOn="{x:Bind ViewModel.RememberLastState, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsExpander
                    Description="Used when Remember last state is off."
                    Header="Default view, sort and filters"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE71C;}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="View">
                            <ComboBox
                                MinWidth="180"
                                AutomationProperties.AutomationId="LibraryDefaultViewCombo"
                                AutomationProperties.Name="Default view"
                                ItemsSource="{x:Bind ViewModel.ViewModeOptions}"
                                SelectedIndex="{x:Bind ViewModel.DefaultViewModeIndex, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Sort">
                            <ComboBox
                                MinWidth="180"
                                AutomationProperties.AutomationId="LibraryDefaultSortCombo"
                                AutomationProperties.Name="Default sort"
                                ItemsSource="{x:Bind ViewModel.SortOptions}"
                                SelectedIndex="{x:Bind ViewModel.DefaultSortIndex, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Type">
                            <ComboBox
                                MinWidth="180"
                                AutomationProperties.AutomationId="LibraryDefaultTypeCombo"
                                AutomationProperties.Name="Default type filter"
                                ItemsSource="{x:Bind ViewModel.TypeFilterOptions}"
                                SelectedIndex="{x:Bind ViewModel.DefaultTypeFilterIndex, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Date">
                            <ComboBox
                                MinWidth="180"
                                AutomationProperties.AutomationId="LibraryDefaultDateCombo"
                                AutomationProperties.Name="Default date filter"
                                ItemsSource="{x:Bind ViewModel.DateFilterOptions}"
                                SelectedIndex="{x:Bind ViewModel.DefaultDateFilterIndex, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Display" />
            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Show the first line of a clip's notes on cards and rows."
                    Header="Notes preview"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE70B;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryNotesPreviewToggle"
                        AutomationProperties.Name="Notes preview"
                        IsOn="{x:Bind ViewModel.ShowNotesPreview, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Favorite, Open and Copy buttons on every list row."
                    Header="Quick actions in list view"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE945;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryQuickActionsToggle"
                        AutomationProperties.Name="Quick actions in list view"
                        IsOn="{x:Bind ViewModel.ShowQuickActions, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Tighter rows that hide tags and notes."
                    Header="Compact list"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryCompactListToggle"
                        AutomationProperties.Name="Compact list"
                        IsOn="{x:Bind ViewModel.CompactListDensity, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Show upload progress and the uploaded badge on clips."
                    Header="Upload status"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE898;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryUploadStatusToggle"
                        AutomationProperties.Name="Upload status"
                        IsOn="{x:Bind ViewModel.ShowUploadStatus, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Behavior" />
            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Ask before permanently deleting clips."
                    Header="Confirm delete"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE74D;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryConfirmDeleteToggle"
                        AutomationProperties.Name="Confirm delete"
                        IsOn="{x:Bind ViewModel.ConfirmDelete, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Hide files in your save folder that weren't captured by Tiny Clips."
                    Header="Only show Tiny Clips captures"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE71C;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryIgnoreForeignToggle"
                        AutomationProperties.Name="Only show Tiny Clips captures"
                        IsOn="{x:Bind ViewModel.IgnoreNonTinyClipsFiles, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="The Library already updates live as files change; set a timer to rescan anyway. 0 turns it off."
                    Header="Auto-refresh interval (seconds)"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE72C;}">
                    <NumberBox
                        MinWidth="140"
                        AutomationProperties.AutomationId="LibraryAutoRefreshBox"
                        AutomationProperties.Name="Auto-refresh interval in seconds"
                        LargeChange="30"
                        Maximum="3600"
                        Minimum="0"
                        SmallChange="5"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.AutoRefreshSeconds, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Archive" />
            <StackPanel Spacing="2">
                <controls:SettingsExpander
                    Description="Move older clips into an Archive folder next to your captures. Nothing is deleted."
                    Header="Archive old clips automatically"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="LibraryArchiveToggle"
                        AutomationProperties.Name="Archive old clips automatically"
                        IsOn="{x:Bind ViewModel.ArchiveOldClips, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Archive clips older than (days)">
                            <NumberBox
                                MinWidth="140"
                                AutomationProperties.AutomationId="LibraryArchiveDaysBox"
                                AutomationProperties.Name="Archive clips older than days"
                                IsEnabled="{x:Bind ViewModel.ArchiveOldClips, Mode=OneWay}"
                                LargeChange="30"
                                Maximum="3650"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.ArchiveAfterDays, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <controls:SettingsCard
                Margin="0,16,0,0"
                Description="Restore every Clips Library preference above to its default."
                Header="Reset Library settings"
                HeaderIcon="{ui:FontIcon Glyph=&#xE777;}">
                <Button
                    AutomationProperties.AutomationId="LibraryResetSettingsButton"
                    Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                    Content="Reset" />
            </controls:SettingsCard>
        </StackPanel>
    </Border>
</UserControl>
