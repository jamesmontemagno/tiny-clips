<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.StudioSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:studio="using:TinyClips.App.ViewModels.Studio"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                Margin="4,8,0,4"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Studio" />

            <TextBlock
                Margin="4,4,0,0"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Tiny Clips Studio" />

            <!--  The switch is always there. What follows it shows once Studio is switched on.  -->
            <controls:SettingsCard
                Header="Tiny Clips Studio (Preview)"
                HeaderIcon="{ui:FontIcon Glyph=&#xE714;}">
                <controls:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock
                            Text="An editor for video recordings. A recording made for Studio keeps the screen, the camera, and the clicks apart, so you can arrange them over a background, zoom, cut, and change the layout before you export. It is a preview: parts of it are unfinished."
                            TextWrapping="Wrap" />
                        <!--  What switching it off left on disk. Nothing is deleted by the switch.  -->
                        <TextBlock
                            Margin="0,4,0,0"
                            AutomationProperties.AutomationId="StudioKeptNoteText"
                            Text="{x:Bind ViewModel.StudioKeptNote, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.StudioKeptNoteVisibility, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <ToggleSwitch
                    AutomationProperties.AutomationId="StudioPreviewToggle"
                    AutomationProperties.Name="Tiny Clips Studio (Preview)"
                    IsOn="{x:Bind ViewModel.IsStudioPreviewEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.StudioPreviewVisibility, Mode=OneWay}">
                <TextBlock
                    Margin="4,16,0,0"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Recording" />

                <!--  It says how a Studio recording is started. There is nothing to set: the tray command is the one way in.  -->
                <controls:SettingsCard
                    AutomationProperties.AutomationId="StudioRecordingHowToCard"
                    Description="Studio recording keeps the screen and camera as separate layers and opens the editor when the recording ends. Record video, from the tray menu or with its hotkey, is always an ordinary recording."
                    Header="Choose Studio recording in the tray menu"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE81E;}" />

                <!--
                    Projects goes here, between Recording and Storage, as on the Mac: a heading like
                    the others and one card with Open project, which opens a project that was saved
                    as a folder (#429).
                -->

                <TextBlock
                    Margin="4,16,0,0"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Storage" />

                <StackPanel Spacing="2">
                    <controls:SettingsCard
                        Header="Project storage"
                        HeaderIcon="{ui:FontIcon Glyph=&#xEDA2;}">
                        <controls:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock
                                    AutomationProperties.AutomationId="StudioStorageSummaryText"
                                    Text="{x:Bind ViewModel.StudioStorageDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="The sources of exported projects are deleted by the two rules below. Drafts that were never exported are never deleted automatically, and neither is a project whose exported video is gone or one you chose to keep. Exported videos are never touched."
                                    TextWrapping="Wrap" />
                                <!--  The projects are in the package's own folder, which goes with the package.  -->
                                <TextBlock
                                    AutomationProperties.AutomationId="StudioUninstallNoteText"
                                    Text="Projects are stored with the app. Uninstalling Tiny Clips, or resetting it in Windows Settings, deletes all of them, drafts included."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="StudioCleanupStatusText"
                                    AutomationProperties.AutomationId="StudioCleanupStatusText"
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.StudioCleanupStatus, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.StudioCleanupStatusVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard.Description>
                        <Button
                            x:Name="StudioCleanUpNowButton"
                            AutomationProperties.AutomationId="StudioCleanUpNowButton"
                            AutomationProperties.Name="Clean up now: Studio projects"
                            Click="OnCleanUpStudioProjects"
                            Content="Clean up now" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="Days since an exported project was last opened. 0 keeps them until you delete the project."
                        Header="Delete sources after"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="StudioSourceRetentionDaysNumberBox"
                            AutomationProperties.Name="Delete Studio sources after, in days"
                            Maximum="365"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.StudioSourceRetentionDays, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Description="Gigabytes the exported projects may use. Past that, the ones opened longest ago are deleted first, and the one you opened last is always kept. Drafts and projects you keep are not counted. 0 means no limit."
                        Header="Storage limit"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="StudioStorageCapNumberBox"
                            AutomationProperties.Name="Studio storage limit in gigabytes"
                            Maximum="500"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.StudioStorageCapGigabytes, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <!--
                    Recordings that only their project holds: kept without exporting, exported to a
                    video that is gone, or in a project that cannot be read. None of them has a
                    video in the Clips Library.
                -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.StudioDraftsVisibility, Mode=OneWay}">
                    <TextBlock
                        Margin="4,16,0,0"
                        AutomationProperties.AutomationId="StudioDraftsHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Drafts" />
                    <ItemsRepeater
                        x:Name="StudioDraftsRepeater"
                        AutomationProperties.AutomationId="StudioDraftsList"
                        ItemsSource="{x:Bind ViewModel.StudioDrafts, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="studio:StudioDraftItem">
                                <controls:SettingsCard Header="{x:Bind Name, Mode=OneTime}">
                                    <controls:SettingsCard.Description>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Details, Mode=OneWay}" TextWrapping="Wrap" />
                                            <!--  Why it is here although it is not a draft like the others.  -->
                                            <TextBlock
                                                Text="{x:Bind Note, Mode=OneTime}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasNote, Mode=OneTime}" />
                                            <!--  A disabled button shows no tooltip, so the reason is written out.  -->
                                            <TextBlock
                                                Text="{x:Bind studio:StudioDraftItem.OpenInStudioNote, Mode=OneTime}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind IsOpen, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.AutomationId="{x:Bind OpenButtonId, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind OpenButtonName, Mode=OneTime}"
                                            Click="OnOpenStudioDraft"
                                            Content="Open"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Open this draft in Studio"
                                            Visibility="{x:Bind CanOpen, Mode=OneTime}" />
                                        <!--
                                            The way out for a recording Studio cannot show: the screen recording as an ordinary video.

                                            The button is not disabled while the recording is copied. A button that is disabled
                                            while it has the keyboard focus passes the focus on, here to Delete, and the next
                                            Enter or Space would ask to delete the draft. It keeps its name, shows and reads
                                            that it is busy, and a press then saves nothing more. Both of its labels take their
                                            room and one of them is seen, so that it keeps its width and the buttons beside it
                                            stay where they are.
                                        -->
                                        <Button
                                            AutomationProperties.AutomationId="{x:Bind SaveRecordingButtonId, Mode=OneTime}"
                                            AutomationProperties.HelpText="{x:Bind SaveRecordingHelpText, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind SaveRecordingButtonName, Mode=OneTime}"
                                            Click="OnSaveStudioDraftRecording"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Save the screen recording to your videos folder as an ordinary video"
                                            Visibility="{x:Bind CanSaveRecording, Mode=OneTime}">
                                            <Grid>
                                                <TextBlock
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Opacity="0"
                                                    Text="{x:Bind studio:StudioDraftItem.SaveRecordingText, Mode=OneTime}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Text="{x:Bind SaveRecordingLabel, Mode=OneWay}" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="{x:Bind DeleteButtonId, Mode=OneTime}"
                                            AutomationProperties.HelpText="{x:Bind DeleteHelpText, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind DeleteButtonName, Mode=OneTime}"
                                            Click="OnDeleteStudioDraft"
                                            Content="Delete&#x2026;"
                                            IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Delete this draft and its recordings" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
