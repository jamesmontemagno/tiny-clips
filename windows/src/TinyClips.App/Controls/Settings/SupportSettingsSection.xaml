<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.SupportSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TinyClips.App.Models.Support"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <StackPanel Margin="4,8,4,12" Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Support" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Tiny Clips is always free. Become a supporter to help fund independent development."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                AutomationProperties.AutomationId="SupportMessageInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />

            <StackPanel
                Margin="4,12"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="Loading supporter plans"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="Loading supporter plans..." />
            </StackPanel>

            <InfoBar
                AutomationProperties.AutomationId="SupportUnavailableInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}"
                Message="Check your connection and try again. Every Tiny Clips feature keeps working either way."
                Severity="Warning"
                Title="Supporter plans aren't available right now">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="SupportTryAgainButton"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  The thank-you, once this account has a plan.  -->
            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsSupporter, Mode=OneWay}">
                <controls:SettingsCard
                    AutomationProperties.AutomationId="SupporterStatusCard"
                    Description="{x:Bind ViewModel.ActivePlanText, Mode=OneWay}"
                    Header="Supporter">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE735;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Border
                        Padding="10,3"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10">
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Supporter" />
                    </Border>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Change your payment method or cancel in your Microsoft account."
                    Header="Your subscription"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8C7;}"
                    Visibility="{x:Bind ViewModel.ShowsManageSubscription, Mode=OneWay}">
                    <HyperlinkButton
                        AutomationProperties.AutomationId="SupportManageSubscriptionLink"
                        AutomationProperties.Name="Manage subscription in your Microsoft account"
                        Content="Manage subscription"
                        NavigateUri="https://account.microsoft.com/services" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  The plans, for everyone else.  -->
            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.ShowsOffers, Mode=OneWay}">
                <controls:SettingsCard
                    Description="Every feature is free for everyone. Becoming a supporter adds a Supporter badge in Settings as a thank-you, and doesn't unlock anything else."
                    Header="All features included"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE73E;}" />
                <ItemsControl
                    AutomationProperties.Name="Supporter plans"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Offers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SupporterOfferItem">
                            <controls:SettingsCard
                                Description="{x:Bind Description}"
                                Header="{x:Bind Title}"
                                HeaderIcon="{ui:FontIcon Glyph=&#xEB51;}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind HasBadge}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Badge}" />
                                    </Border>
                                    <Button
                                        AutomationProperties.Name="{x:Bind PurchaseAutomationName}"
                                        Command="{x:Bind PurchaseCommand}"
                                        CommandParameter="{x:Bind}"
                                        Content="{x:Bind PurchaseLabel}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="4,8,4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Monthly and yearly plans renew automatically until you cancel in your Microsoft account. The Microsoft Store handles payment, and shows the final price before you confirm."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton
                        AutomationProperties.AutomationId="SupportPrivacyLink"
                        Content="Privacy Policy"
                        NavigateUri="https://tinyclips.app/privacy.html" />
                    <HyperlinkButton
                        AutomationProperties.AutomationId="SupportTermsLink"
                        Content="Microsoft Store Terms of Sale"
                        NavigateUri="https://www.microsoft.com/en-us/store/b/terms-of-sale" />
                </StackPanel>
            </StackPanel>

            <controls:SettingsCard
                Margin="0,8,0,0"
                Description="Licenses follow your Microsoft account. Check for a plan you already have."
                Header="Restore purchases"
                HeaderIcon="{ui:FontIcon Glyph=&#xE72C;}"
                Visibility="{x:Bind ViewModel.ShowsRestore, Mode=OneWay}">
                <Button
                    AutomationProperties.AutomationId="SupportRestoreButton"
                    Command="{x:Bind ViewModel.RestoreCommand}"
                    Content="Restore" />
            </controls:SettingsCard>
        </StackPanel>
    </Border>
</UserControl>
