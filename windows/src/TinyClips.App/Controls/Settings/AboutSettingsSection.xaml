<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.AboutSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                Margin="4,8,0,4"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="About" />

            <controls:SettingsExpander
                Header="Tiny Clips for Windows"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/AppIcon.ico" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Description>
                    <TextBlock
                        x:Name="AboutCopyrightText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="© Refractored LLC" />
                </controls:SettingsExpander.Description>
                <TextBlock
                    x:Name="AboutVersionText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="Version" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        x:Name="DirectBuildUpdatesCard"
                        Header="Updates (Direct build)"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Direct installs check for signed updates about every 24 hours. You can also update through winget."
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="UpdateStatusText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Check for updates to see whether a newer version is available."
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    HorizontalAlignment="Left"
                                    Content="Check for updates"
                                    Click="OnCheckForUpdatesClicked" />
                                <Button
                                    x:Name="CopyWingetCommandButton"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Content="Copy winget command"
                                    Click="OnCopyWingetCommandClicked" />
                                <Button
                                    x:Name="OpenLatestReleaseButton"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Content="Open latest release"
                                    Click="OnOpenLatestReleaseClicked" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        x:Name="StoreBuildUpdatesCard"
                        Description="Updates are installed automatically through Microsoft Store."
                        Header="Updates (Microsoft Store build)"
                        Visibility="Collapsed" />

                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AboutRepoLink"
                        AutomationProperties.Name="Open the Tiny Clips GitHub repository"
                        Click="OnOpenRepositoryClicked"
                        Header="GitHub repository"
                        IsClickEnabled="True">
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        x:Name="AboutFileBugButton"
                        AutomationProperties.AutomationId="AboutFileBugButton"
                        AutomationProperties.Name="Open quick bug report form"
                        Click="OnFileBugClick"
                        Header="File a bug"
                        IsClickEnabled="True">
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AboutDetailedIssueLink"
                        AutomationProperties.Name="Open detailed issue template on GitHub"
                        Click="OnOpenDetailedIssueClicked"
                        Header="Open detailed issue template"
                        IsClickEnabled="True">
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </Border>
</UserControl>
