<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.AgentControlSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:TinyClips.App.ViewModels"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <StackPanel Margin="4,8,4,12" Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Agent control" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Let AI agents on this PC take captures, record, and manage your clips through the tinyclips command-line tool and MCP server."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                AutomationProperties.AutomationId="AgentControlErrorInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Error"
                Title="Agent control is not available"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Header="Allow agents to control Tiny Clips"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE99A;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="AgentControlEnabledToggle"
                        AutomationProperties.Name="Allow agents to control Tiny Clips"
                        IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Agents connect to this named pipe. Only your Windows account can open it."
                    Header="Connection"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE968;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Agent connection endpoint"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Endpoint}" />
                        <Button
                            AutomationProperties.AutomationId="AgentControlCopyEndpointButton"
                            AutomationProperties.Name="Copy connection endpoint"
                            Command="{x:Bind ViewModel.CopyEndpointCommand}"
                            ToolTipService.ToolTip="Copy">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Paired agents" />
            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="When an agent pairs, Tiny Clips asks you first. Deleting, uploading, and discarding always ask again."
                    Header="No agents are paired"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE716;}"
                    Visibility="{x:Bind ViewModel.NoClientsVisibility, Mode=OneWay}" />
                <ItemsControl
                    AutomationProperties.Name="Paired agents"
                    ItemsSource="{x:Bind ViewModel.Clients}"
                    Visibility="{x:Bind ViewModel.ClientsVisibility, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgentClientItem">
                            <controls:SettingsCard
                                Description="{x:Bind UsageText}"
                                Header="{x:Bind Name}"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE99A;}">
                                <controls:SettingsCard.Content>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <TextBlock
                                            MaxWidth="320"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ScopesText}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            AutomationProperties.Name="{x:Bind RevokeName}"
                                            Command="{x:Bind RevokeCommand}"
                                            Content="Revoke" />
                                    </StackPanel>
                                </controls:SettingsCard.Content>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:SettingsCard
                    Description="Every paired agent will have to pair again."
                    Header="Revoke all agents"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8D8;}"
                    Visibility="{x:Bind ViewModel.ClientsVisibility, Mode=OneWay}">
                    <Button
                        AutomationProperties.AutomationId="AgentControlRevokeAllButton"
                        AutomationProperties.Name="Revoke all agents"
                        Command="{x:Bind ViewModel.RevokeAllCommand}"
                        Content="Revoke all" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Activity" />
            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Every agent request is recorded with the agent, the command, and whether it was allowed."
                    Header="Audit log"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="AgentControlOpenAuditLogButton"
                            AutomationProperties.Name="Open audit log"
                            Command="{x:Bind ViewModel.OpenAuditLogCommand}"
                            Content="Open audit log" />
                        <Button
                            AutomationProperties.AutomationId="AgentControlOpenFolderButton"
                            AutomationProperties.Name="Open agent data folder"
                            Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                            Content="Open folder" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,4,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Get started" />
            <controls:SettingsExpander
                Description="Install the .NET 10 SDK and TinyClips tool, pair once, then try a capture."
                Header="Connect an agent"
                HeaderIcon="{ui:FontIcon Glyph=&#xE756;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="1. Install the tool (requires the .NET 10 SDK)">
                        <StackPanel Spacing="8">
                            <HyperlinkButton Content="Download .NET 10" NavigateUri="https://dotnet.microsoft.com/download/dotnet/10.0" />
                            <TextBlock AutomationProperties.Name="Install command" FontFamily="Consolas" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.InstallCommand}" TextWrapping="Wrap" />
                            <Button Content="Copy install command" Command="{x:Bind ViewModel.CopySetupTextCommand}" CommandParameter="{x:Bind ViewModel.InstallCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="2. Turn on agent control above, then pair">
                        <StackPanel Spacing="8">
                            <TextBlock AutomationProperties.Name="Pair command" FontFamily="Consolas" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.PairCommand}" TextWrapping="Wrap" />
                            <Button Content="Copy pair command" Command="{x:Bind ViewModel.CopySetupTextCommand}" CommandParameter="{x:Bind ViewModel.PairCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Description="Keep Tiny Clips running. Approve the requested permissions in the app, then check the connection."
                        Header="3. Approve and verify">
                        <StackPanel Spacing="8">
                            <TextBlock AutomationProperties.Name="Status command" FontFamily="Consolas" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.StatusCommand}" TextWrapping="Wrap" />
                            <Button Content="Copy status command" Command="{x:Bind ViewModel.CopySetupTextCommand}" CommandParameter="{x:Bind ViewModel.StatusCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Description="Ask an agent with terminal access: Use Tiny Clips to capture the Copilot window, inspect the image, add an arrow toward Create PR and an eyes emoji, and save a new copy."
                        Header="4. Try your first capture" />
                    <controls:SettingsCard
                        Description="Pair first, then add this local stdio server in your agent's MCP settings. Use the same Windows account. Restart or reload the MCP connection afterward. Configuration placement varies by agent."
                        Header="Connect through MCP">
                        <StackPanel MaxWidth="360" Spacing="8">
                            <TextBlock AutomationProperties.Name="MCP configuration" FontFamily="Consolas" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.McpConfiguration}" TextWrapping="Wrap" />
                            <Button Content="Copy MCP configuration" Command="{x:Bind ViewModel.CopySetupTextCommand}" CommandParameter="{x:Bind ViewModel.McpConfiguration}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Description="Default pairing grants read, capture, record, edit, and export. Deleting, uploading, and discarding always need approval. Turn off Agent Control or revoke access at any time. OS microphone and camera permissions still apply."
                        Header="You stay in control" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <HyperlinkButton
                HorizontalAlignment="Left"
                Content="Full setup, Skills, and example prompts"
                NavigateUri="https://github.com/jamesmontemagno/tiny-clips/blob/main/docs/agent-integration.md" />
            <TextBlock
                Margin="4,0"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SetupCopyStatus, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
