<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.VideoSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TinyClips.App.Settings.Sections"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="4">
            <TextBlock
                Margin="4,8,0,4"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Video" />

            <TextBlock
                Margin="4,4,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Video quality" />

            <controls:SettingsCard
                Description="Frames per second for recorded video."
                Header="Frame rate"
                HeaderIcon="{ui:FontIcon Glyph=&#xE714;}">
                <NumberBox
                    Width="120"
                    AutomationProperties.AutomationId="VideoFrameRateNumberBox"
                    AutomationProperties.Name="Video frame rate"
                    Maximum="60"
                    Minimum="10"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.VideoFrameRate, Mode=TwoWay}" />
            </controls:SettingsCard>

            <TextBlock
                Margin="4,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Audio" />

            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Header="Record system audio"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE767;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="RecordAudioToggle"
                        AutomationProperties.Name="Record system audio"
                        IsOn="{x:Bind ViewModel.RecordAudio, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Header="Microphone"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE720;}"
                    IsExpanded="True">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="RecordMicrophoneToggle"
                        AutomationProperties.Name="Record microphone"
                        IsOn="{x:Bind ViewModel.RecordMicrophone, Mode=OneWay}"
                        Toggled="OnRecordMicrophoneToggled" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Microphone device used for recording">
                            <Grid MinWidth="220">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.MicrophoneLoadingVisibility, Mode=OneWay}">
                                    <ProgressRing Width="20" Height="20" IsActive="True" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Loading microphones..." />
                                </StackPanel>
                                <ComboBox
                                    AutomationProperties.AutomationId="MicrophoneDeviceCombo"
                                    AutomationProperties.Name="Microphone device"
                                    DisplayMemberPath="Name"
                                    IsEnabled="{x:Bind ViewModel.MicrophoneSelectorEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.MicrophoneSelectorVisibility, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox
                                AutomationProperties.AutomationId="MicrophoneLimiterToggle"
                                AutomationProperties.Name="Limit microphone peaks"
                                Content="Limit microphone peaks"
                                IsChecked="{x:Bind ViewModel.MicrophoneLimiterEnabled, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.RecordMicrophone, Mode=OneWay}"
                                ToolTipService.ToolTip="Softly rounds off loud microphone peaks so hot input doesn't distort. Does not affect timing or system audio." />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind local:VideoSettingsSection.HasError(ViewModel.MediaDevicesLoadError), Mode=OneWay}"
                Message="{x:Bind ViewModel.MediaDevicesLoadError, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />

            <TextBlock
                Margin="4,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Webcam overlay" />

            <controls:SettingsExpander
                Header="Webcam overlay"
                HeaderIcon="{ui:FontIcon Glyph=&#xE722;}"
                IsExpanded="True">
                <Grid MinWidth="220">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.WebcamLoadingVisibility, Mode=OneWay}">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Loading webcams..." />
                    </StackPanel>
                    <ComboBox
                        MinWidth="220"
                        AutomationProperties.AutomationId="WebcamDeviceCombo"
                        AutomationProperties.Name="Webcam device"
                        DisplayMemberPath="Name"
                        IsEnabled="{x:Bind ViewModel.WebcamDeviceSelectorEnabled, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Webcams, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedWebcam, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.WebcamSelectorVisibility, Mode=OneWay}" />
                </Grid>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard ContentAlignment="Left">
                        <CheckBox
                            AutomationProperties.AutomationId="EnableWebcamToggle"
                            AutomationProperties.Name="Enable webcam by default"
                            Checked="OnEnableWebcamChecked"
                            Content="Enable webcam by default"
                            IsChecked="{x:Bind ViewModel.WebcamEnabled, Mode=OneWay}"
                            Unchecked="OnEnableWebcamUnchecked" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Webcam shape">
                        <ComboBox
                            MinWidth="220"
                            AutomationProperties.AutomationId="WebcamShapeCombo"
                            AutomationProperties.Name="Webcam shape"
                            SelectedIndex="{x:Bind ViewModel.WebcamShapeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Rectangle" />
                            <ComboBoxItem Content="Rounded rectangle" />
                            <ComboBoxItem Content="Circle" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Webcam corner">
                        <ComboBox
                            MinWidth="220"
                            AutomationProperties.AutomationId="WebcamCornerPositionCombo"
                            AutomationProperties.Name="Webcam corner"
                            SelectedIndex="{x:Bind ViewModel.WebcamCornerPositionIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Top left" />
                            <ComboBoxItem Content="Top right" />
                            <ComboBoxItem Content="Bottom left" />
                            <ComboBoxItem Content="Bottom right" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Webcam size">
                        <ComboBox
                            MinWidth="220"
                            AutomationProperties.AutomationId="WebcamSizePresetCombo"
                            AutomationProperties.Name="Webcam size"
                            SelectedIndex="{x:Bind ViewModel.WebcamSizePresetIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Small" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Large" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Rounded corner value (-1 uses the default)">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="WebcamCornerRadiusNumberBox"
                            AutomationProperties.Name="Webcam rounded corner value"
                            IsEnabled="{x:Bind ViewModel.WebcamCornerRadiusEnabled, Mode=OneWay}"
                            Maximum="200"
                            Minimum="-1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.WebcamCornerRadius, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock
                Margin="4,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Recording &amp; output" />

            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Description="Prevent the display from dimming or sleeping during video and GIF recordings."
                    Header="Keep display awake while recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="KeepDisplayAwakeToggle"
                        AutomationProperties.Name="Keep display awake while recording"
                        IsOn="{x:Bind ViewModel.KeepDisplayAwakeWhileRecording, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Choose Region, Screen, or Window before recording."
                    Header="Show capture picker before recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE722;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowVideoCapturePickerToggle"
                        AutomationProperties.Name="Show capture picker before recording"
                        IsOn="{x:Bind ViewModel.ShowVideoCapturePicker, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Countdown before recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <NumberBox
                            Width="120"
                            AutomationProperties.AutomationId="VideoCountdownDurationNumberBox"
                            AutomationProperties.Name="Video countdown seconds"
                            IsEnabled="{x:Bind ViewModel.VideoCountdownEnabled, Mode=OneWay}"
                            Maximum="10"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.VideoCountdownDuration, Mode=TwoWay}" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="VideoCountdownToggle"
                            AutomationProperties.Name="Enable video countdown"
                            IsOn="{x:Bind ViewModel.VideoCountdownEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Stop recording automatically after this many minutes (0 = no limit)."
                    Header="Recording time limit"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                    <NumberBox
                        Width="120"
                        AutomationProperties.AutomationId="VideoTimeLimitNumberBox"
                        AutomationProperties.Name="Video recording time limit in minutes"
                        Maximum="180"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.VideoRecordingTimeLimitMinutes, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Review and trim the start and end before saving."
                    Header="Open trimmer after recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE70F;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowVideoTrimmerToggle"
                        AutomationProperties.Name="Open video trimmer after recording"
                        IsOn="{x:Bind ViewModel.ShowTrimmer, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Copy the recorded MP4 file so it can be pasted into chats and editors."
                    Header="Copy video to the clipboard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8C8;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="CopyVideoToggle"
                        AutomationProperties.Name="Copy video to the clipboard"
                        IsOn="{x:Bind ViewModel.CopyVideoToClipboard, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Start another recording with the same picker after saving."
                    Header="Show capture picker after recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShowVideoCapturePickerAfterCaptureToggle"
                        AutomationProperties.Name="Show capture picker after recording"
                        IsEnabled="{x:Bind ViewModel.VideoCapturePickerAfterCaptureEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.ShowVideoCapturePickerAfterCapture, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
