<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.HotkeysSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="8">
            <TextBlock
                Margin="4,8,0,4"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Keyboard shortcuts" />

            <InfoBar
                AutomationProperties.AutomationId="HotKeyInstructionsInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="Global shortcuts work in other apps too. Only Screenshot is assigned by default. Choose Edit to set one, Delete to remove it, or Reset to restore its default."
                Severity="Informational" />

            <InfoBar
                x:Name="HotKeyStatusInfoBar"
                AutomationProperties.AutomationId="HotKeyStatusInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsOpen="False" />

            <StackPanel Spacing="2">
                <TextBlock
                    Margin="4,16,0,8"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Screenshots - global" />
                <controls:SettingsCard
                    Header="Screenshot"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE722;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotHotKeyButton"
                        AutomationProperties.Name="Edit screenshot shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Screenshot" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotHotKeyButton"
                        AutomationProperties.Name="Reset screenshot shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Screenshot" />
                    <Button
                        AutomationProperties.AutomationId="DeleteScreenshotHotKeyButton"
                        AutomationProperties.Name="Delete screenshot shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="Screenshot" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional. Skips the capture picker and goes straight to region selection. Not set by default."
                    Header="Screenshot region"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7A8;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotRegionHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotRegionHotKeyButton"
                        AutomationProperties.Name="Edit screenshot region shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="ScreenshotRegion" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotRegionHotKeyButton"
                        AutomationProperties.Name="Reset screenshot region shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="ScreenshotRegion" />
                    <Button
                        AutomationProperties.AutomationId="DeleteScreenshotRegionHotKeyButton"
                        AutomationProperties.Name="Delete screenshot region shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="ScreenshotRegion" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional. Skips the capture picker and goes straight to window selection. Not set by default."
                    Header="Screenshot window"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE737;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotWindowHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotWindowHotKeyButton"
                        AutomationProperties.Name="Edit screenshot window shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="ScreenshotWindow" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotWindowHotKeyButton"
                        AutomationProperties.Name="Reset screenshot window shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="ScreenshotWindow" />
                    <Button
                        AutomationProperties.AutomationId="DeleteScreenshotWindowHotKeyButton"
                        AutomationProperties.Name="Delete screenshot window shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="ScreenshotWindow" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional. Skips the capture picker and captures a screen. Not set by default."
                    Header="Screenshot screen"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotScreenHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotScreenHotKeyButton"
                        AutomationProperties.Name="Edit screenshot screen shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="ScreenshotScreen" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotScreenHotKeyButton"
                        AutomationProperties.Name="Reset screenshot screen shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="ScreenshotScreen" />
                    <Button
                        AutomationProperties.AutomationId="DeleteScreenshotScreenHotKeyButton"
                        AutomationProperties.Name="Delete screenshot screen shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="ScreenshotScreen" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    Margin="4,16,0,8"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Recording - global" />
                <controls:SettingsCard
                    Description="Optional, not set by default. Makes an ordinary recording, not Studio."
                    Header="Record video"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE714;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.VideoHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditVideoHotKeyButton"
                        AutomationProperties.Name="Edit record video shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Video" />
                    <Button
                        AutomationProperties.AutomationId="ResetVideoHotKeyButton"
                        AutomationProperties.Name="Reset record video shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Video" />
                    <Button
                        AutomationProperties.AutomationId="DeleteVideoHotKeyButton"
                        AutomationProperties.Name="Delete record video shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="Video" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Studio recording"
                    Description="Optional, not set by default. Keeps editable screen and camera layers and opens Studio."
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8D4;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            MinWidth="120"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.StudioRecordingHotKeyDisplay, Mode=OneWay}" />
                        </Border>
                        <Button
                            AutomationProperties.AutomationId="EditStudioRecordingHotKeyButton"
                            AutomationProperties.Name="Edit Studio recording shortcut"
                            Click="OnEditHotKey"
                            Content="Edit"
                            Tag="StudioRecording" />
                        <Button
                            AutomationProperties.AutomationId="ResetStudioRecordingHotKeyButton"
                            AutomationProperties.Name="Reset Studio recording shortcut"
                            Click="OnResetHotKey"
                            Content="Reset"
                            Tag="StudioRecording" />
                        <Button
                            AutomationProperties.AutomationId="DeleteStudioRecordingHotKeyButton"
                            AutomationProperties.Name="Delete Studio recording shortcut"
                            Click="OnDeleteHotKey"
                            Content="Delete"
                            Tag="StudioRecording" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional, not set by default."
                    Header="Record GIF"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF4A9;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.GifHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditGifHotKeyButton"
                        AutomationProperties.Name="Edit record GIF shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Gif" />
                    <Button
                        AutomationProperties.AutomationId="ResetGifHotKeyButton"
                        AutomationProperties.Name="Reset record GIF shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Gif" />
                    <Button
                        AutomationProperties.AutomationId="DeleteGifHotKeyButton"
                        AutomationProperties.Name="Delete record GIF shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="Gif" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional, not set by default. Active only during recording. You can always use the floating Stop button or tray."
                    Header="Stop recording"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE71A;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            MinWidth="120"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.StopRecordingHotKeyDisplay, Mode=OneWay}" />
                        </Border>
                        <Button
                            AutomationProperties.AutomationId="EditStopRecordingHotKeyButton"
                            AutomationProperties.Name="Edit stop recording shortcut"
                            Click="OnEditHotKey"
                            Content="Edit"
                            Tag="StopRecording" />
                        <Button
                            AutomationProperties.AutomationId="ResetStopRecordingHotKeyButton"
                            AutomationProperties.Name="Reset stop recording shortcut"
                            Click="OnResetHotKey"
                            Content="Reset"
                            Tag="StopRecording" />
                        <Button
                            AutomationProperties.AutomationId="DeleteStopRecordingHotKeyButton"
                            AutomationProperties.Name="Delete stop recording shortcut"
                            Click="OnDeleteHotKey"
                            Content="Delete"
                            Tag="StopRecording" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    Margin="4,16,0,8"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Text recognition - global" />
                <controls:SettingsCard
                    Description="Optional, not set by default."
                    Header="Recognize text"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.OcrHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditOcrHotKeyButton"
                        AutomationProperties.Name="Edit recognize text shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="RecognizeText" />
                    <Button
                        AutomationProperties.AutomationId="ResetOcrHotKeyButton"
                        AutomationProperties.Name="Reset recognize text shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="RecognizeText" />
                    <Button
                        AutomationProperties.AutomationId="DeleteOcrHotKeyButton"
                        AutomationProperties.Name="Delete recognize text shortcut"
                        Click="OnDeleteHotKey"
                        Content="Delete"
                        Tag="RecognizeText" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock
                Margin="4,16,0,8"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Window &amp; navigation shortcuts" />
            <TextBlock
                Margin="4,0,4,8"
                Text="Reference only. These fixed shortcuts work in the active Tiny Clips window, not in other apps. Text fields and focused controls keep their normal keyboard behavior."
                TextWrapping="Wrap" />

            <controls:SettingsExpander
                Header="Screenshot editor"
                HeaderIcon="{ui:FontIcon Glyph=&#xE70F;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Undo / copy">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+Z / Ctrl+C" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Zoom in / out / fit">
                        <TextBlock FontFamily="Consolas" Text="Ctrl++ / Ctrl+- / Ctrl+0" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Select / crop / rectangle / ellipse">
                        <TextBlock FontFamily="Consolas" Text="V / C / R / O" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Arrow / line / pen / text">
                        <TextBlock FontFamily="Consolas" Text="A / L / D / T" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Counter / emoji / redact">
                        <TextBlock FontFamily="Consolas" Text="N / E / B" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Pan / delete annotation">
                        <TextBlock FontFamily="Consolas" Text="Hold Space / Delete or Backspace" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="Studio"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Play / pause; step frame / second">
                        <TextBlock FontFamily="Consolas" Text="Space; Left/Right / Shift+Left/Right" TextWrapping="Wrap" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Trim start / end; seek start / end">
                        <TextBlock FontFamily="Consolas" Text="I / O; Home / End" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Scene / cut / speed / zoom">
                        <TextBlock FontFamily="Consolas" Text="S / X / R / Z" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Arrow / callout / text / box / ellipse / redact / emoji">
                        <TextBlock FontFamily="Consolas" Text="A / C / T / H / E / B / M" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Layouts">
                        <TextBlock FontFamily="Consolas" Text="1 / 2 / 3 / 4" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Open / save / Save as / export">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+O / Ctrl+S / Ctrl+Shift+S / Ctrl+E" TextWrapping="Wrap" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Undo / redo / duplicate / delete">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+Z / Ctrl+Y or Ctrl+Shift+Z / Ctrl+D / Delete" TextWrapping="Wrap" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="Clips Library"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Search / refresh">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+F / Ctrl+R" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Select all / copy / open">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+A / Ctrl+C / Enter" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Rename / delete / play-pause">
                        <TextBlock FontFamily="Consolas" Text="F2 / Delete / Space" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Grid / list">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+Shift+G / Ctrl+Shift+L" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Details / selection mode">
                        <TextBlock FontFamily="Consolas" Text="Ctrl+Shift+D / Ctrl+Shift+E" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander
                Header="Navigation &amp; application"
                HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Picker: region / screen / window / scroll">
                        <TextBlock FontFamily="Consolas" Text="R / S / W / P" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Scrolling capture: done / cancel" Description="While the scrolling-capture panel has focus.">
                        <TextBlock FontFamily="Consolas" Text="Enter / Esc" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Video and GIF trim bar" Description="Arrows seek. Ctrl adjusts the start, Shift adjusts the end, and Page Up/Down move the range. Home/End seek to the beginning/end.">
                        <TextBlock FontFamily="Consolas" Text="Left / Right / Page Up / Page Down / Home / End" TextWrapping="Wrap" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Close / cancel" Description="Editors use your Escape confirmation preference.">
                        <TextBlock FontFamily="Consolas" Text="Esc" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </Border>
</UserControl>
