<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.HotkeysSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch">
        <StackPanel
            MaxWidth="1064"
            HorizontalAlignment="Stretch"
            Spacing="8">
            <TextBlock
                Margin="4,8,0,4"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Keyboard shortcuts" />

            <InfoBar
                AutomationProperties.AutomationId="HotKeyInstructionsInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="Choose Edit, press a shortcut with Ctrl, Alt, Shift, or Win, then choose Save."
                Severity="Informational" />

            <InfoBar
                x:Name="HotKeyStatusInfoBar"
                AutomationProperties.AutomationId="HotKeyStatusInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsOpen="False" />

            <StackPanel Spacing="2">
                <controls:SettingsCard
                    Header="Screenshot"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE722;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotHotKeyButton"
                        AutomationProperties.Name="Edit screenshot shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Screenshot" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotHotKeyButton"
                        AutomationProperties.Name="Reset screenshot shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Screenshot" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional. Skips the capture picker and goes straight to region selection. Not set by default."
                    Header="Screenshot region"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE722;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotRegionHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotRegionHotKeyButton"
                        AutomationProperties.Name="Edit screenshot region shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="ScreenshotRegion" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotRegionHotKeyButton"
                        AutomationProperties.Name="Reset screenshot region shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="ScreenshotRegion" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Optional. Skips the capture picker and goes straight to window selection. Not set by default."
                    Header="Screenshot window"
                    HeaderIcon="{ui:FontIcon Glyph=&#xEF20;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ScreenshotWindowHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditScreenshotWindowHotKeyButton"
                        AutomationProperties.Name="Edit screenshot window shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="ScreenshotWindow" />
                    <Button
                        AutomationProperties.AutomationId="ResetScreenshotWindowHotKeyButton"
                        AutomationProperties.Name="Reset screenshot window shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="ScreenshotWindow" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Record video"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE714;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.VideoHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditVideoHotKeyButton"
                        AutomationProperties.Name="Edit record video shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Video" />
                    <Button
                        AutomationProperties.AutomationId="ResetVideoHotKeyButton"
                        AutomationProperties.Name="Reset record video shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Video" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Record GIF"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF4A9;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.GifHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditGifHotKeyButton"
                        AutomationProperties.Name="Edit record GIF shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="Gif" />
                    <Button
                        AutomationProperties.AutomationId="ResetGifHotKeyButton"
                        AutomationProperties.Name="Reset record GIF shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="Gif" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Recognize text"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        MinWidth="120"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.OcrHotKeyDisplay, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="EditOcrHotKeyButton"
                        AutomationProperties.Name="Edit recognize text shortcut"
                        Click="OnEditHotKey"
                        Content="Edit"
                        Tag="RecognizeText" />
                    <Button
                        AutomationProperties.AutomationId="ResetOcrHotKeyButton"
                        AutomationProperties.Name="Reset recognize text shortcut"
                        Click="OnResetHotKey"
                        Content="Reset"
                        Tag="RecognizeText" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
