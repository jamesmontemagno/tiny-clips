<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.Studio.StudioTrimBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyClips.App.Controls.Studio"
    Height="36"
    IsTabStop="False">

    <!--  Positions are set in code: the parts are placed by time, not by layout.  -->
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <!--  The whole recording. Pressing or dragging here moves the playhead.  -->
        <Border
            x:Name="Track"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            PointerCanceled="OnTrackPointerEnded"
            PointerCaptureLost="OnTrackPointerEnded"
            PointerMoved="OnTrackPointerMoved"
            PointerPressed="OnTrackPointerPressed"
            PointerReleased="OnTrackPointerEnded" />

        <Canvas x:Name="Parts">
            <!--  The part that is exported.  -->
            <Border
                x:Name="KeptRange"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                IsHitTestVisible="False"
                Opacity="0.3" />

            <local:StudioTrimThumb
                x:Name="StartThumb"
                Width="12"
                AutomationProperties.AutomationId="StudioTrimStart"
                AutomationProperties.Name="Start"
                PointerCanceled="OnThumbPointerEnded"
                PointerCaptureLost="OnThumbPointerEnded"
                PointerMoved="OnThumbPointerMoved"
                PointerPressed="OnThumbPointerPressed"
                PointerReleased="OnThumbPointerEnded"
                ToolTipService.ToolTip="Drag to change where the video starts"
                ValueRequested="OnStartValueRequested">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Rectangle
                        Width="2"
                        Height="14"
                        Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        RadiusX="1"
                        RadiusY="1" />
                </Border>
            </local:StudioTrimThumb>

            <local:StudioTrimThumb
                x:Name="EndThumb"
                Width="12"
                AutomationProperties.AutomationId="StudioTrimEnd"
                AutomationProperties.Name="End"
                PointerCanceled="OnThumbPointerEnded"
                PointerCaptureLost="OnThumbPointerEnded"
                PointerMoved="OnThumbPointerMoved"
                PointerPressed="OnThumbPointerPressed"
                PointerReleased="OnThumbPointerEnded"
                ToolTipService.ToolTip="Drag to change where the video ends"
                ValueRequested="OnEndValueRequested">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Rectangle
                        Width="2"
                        Height="14"
                        Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        RadiusX="1"
                        RadiusY="1" />
                </Border>
            </local:StudioTrimThumb>

            <!--
                The line is two pixels wide. The thumb around it is wider, and filled with nothing,
                so its focus ring and what a screen reader outlines are wide enough to see.
            -->
            <local:StudioTrimThumb
                x:Name="PlayheadThumb"
                Width="12"
                AutomationProperties.AutomationId="StudioPlayhead"
                AutomationProperties.Name="Playhead"
                IsHitTestVisible="False"
                ValueRequested="OnPlayheadValueRequested">
                <Grid Background="Transparent">
                    <Rectangle
                        Width="2"
                        HorizontalAlignment="Center"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>
            </local:StudioTrimThumb>
        </Canvas>
    </Grid>
</UserControl>
