<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.Studio.StudioLaneBlockHandles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyClips.App.Controls.Studio"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <!--
        The handles at the two ends of a zoom, a cut or a speed change: what is dragged to change
        when the block starts or stops. Each is a short upright grip mark. On a block with room
        they are inside its ends, faint until the pointer is over the block or the block is
        selected, and then on a tinted end. On a narrower block there are none until it is
        selected, and then one stands outside each end as a tab in the block's own color. The
        lane handles the pointer and asks the editor model what a press takes hold of; this
        draws the same places and shows the resize pointer over them.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                How strong a grip mark and the tint under it are. A faint mark and a tint are not
                among a contrast theme's colors, so there the mark is at full strength throughout
                and its end is not tinted.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="StudioLaneHandleTintOpacity">0.16</x:Double>
                    <x:Double x:Key="StudioLaneHandleRestOpacity">0.45</x:Double>
                    <x:Double x:Key="StudioLaneHandlePointerOverOpacity">0.8</x:Double>
                    <x:Double x:Key="StudioLaneHandleSelectedOpacity">0.95</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="StudioLaneHandleTintOpacity">0</x:Double>
                    <x:Double x:Key="StudioLaneHandleRestOpacity">1</x:Double>
                    <x:Double x:Key="StudioLaneHandlePointerOverOpacity">1</x:Double>
                    <x:Double x:Key="StudioLaneHandleSelectedOpacity">1</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EmphasisStates">
                <VisualState x:Name="AtRest" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="StartTint.Opacity" Value="{ThemeResource StudioLaneHandleTintOpacity}" />
                        <Setter Target="EndTint.Opacity" Value="{ThemeResource StudioLaneHandleTintOpacity}" />
                        <Setter Target="StartGrip.Opacity" Value="{ThemeResource StudioLaneHandlePointerOverOpacity}" />
                        <Setter Target="EndGrip.Opacity" Value="{ThemeResource StudioLaneHandlePointerOverOpacity}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="StartTint.Opacity" Value="{ThemeResource StudioLaneHandleTintOpacity}" />
                        <Setter Target="EndTint.Opacity" Value="{ThemeResource StudioLaneHandleTintOpacity}" />
                        <Setter Target="StartGrip.Opacity" Value="{ThemeResource StudioLaneHandleSelectedOpacity}" />
                        <Setter Target="EndGrip.Opacity" Value="{ThemeResource StudioLaneHandleSelectedOpacity}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  The widths, the margins, the brushes and what is shown of each handle are set in code.  -->
        <local:StudioLaneHandle
            x:Name="StartHandle"
            HorizontalAlignment="Left"
            Background="Transparent"
            ToolTipService.ToolTip="Drag to change where this starts"
            Visibility="Collapsed">
            <Border x:Name="StartPlate" />
            <Border x:Name="StartTint" Opacity="0" />
            <Border x:Name="StartTab" HorizontalAlignment="Left" />
            <Rectangle
                x:Name="StartGrip"
                Width="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{ThemeResource StudioLaneHandleRestOpacity}"
                RadiusX="1"
                RadiusY="1" />
        </local:StudioLaneHandle>
        <local:StudioLaneHandle
            x:Name="EndHandle"
            HorizontalAlignment="Right"
            Background="Transparent"
            ToolTipService.ToolTip="Drag to change where this ends"
            Visibility="Collapsed">
            <Border x:Name="EndPlate" />
            <Border x:Name="EndTint" Opacity="0" />
            <Border x:Name="EndTab" HorizontalAlignment="Right" />
            <Rectangle
                x:Name="EndGrip"
                Width="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{ThemeResource StudioLaneHandleRestOpacity}"
                RadiusX="1"
                RadiusY="1" />
        </local:StudioLaneHandle>
    </Grid>
</UserControl>
