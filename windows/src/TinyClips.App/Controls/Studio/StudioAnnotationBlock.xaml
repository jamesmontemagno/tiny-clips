<?xml version="1.0" encoding="utf-8" ?>
<local:StudioRangeBlock
    x:Class="TinyClips.App.Controls.Studio.StudioAnnotationBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyClips.App.Controls.Studio"
    IsTabStop="False">

    <local:StudioRangeBlock.Resources>
        <ResourceDictionary>
            <!--
                An annotation is none of the other three kinds of block: it is green with a mark
                of its kind, where a zoom is a tint of the accent color, a cut is hatched and a
                speed change has round ends. A tint is not one of a contrast theme's colors, so
                there the block takes the window color and keeps its outline and its mark.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush
                        x:Key="StudioAnnotationBlockFillBrush"
                        Opacity="0.3"
                        Color="{ThemeResource SystemFillColorSuccess}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush
                        x:Key="StudioAnnotationBlockFillBrush"
                        Opacity="0.3"
                        Color="{ThemeResource SystemFillColorSuccess}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioAnnotationBlockFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </local:StudioRangeBlock.Resources>

    <Grid x:Name="Root">
        <VisualStateManager.VisualStateGroups>
            <!--  The selected annotation is filled, and has a thicker border, so it is not told apart by color alone.  -->
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="2" />
                        <Setter Target="KindIcon.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="Fill"
            Background="{ThemeResource StudioAnnotationBlockFillBrush}"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}" />

        <!--  The list item says all of this in its name, so screen readers skip the parts.  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Orientation="Horizontal"
            Spacing="4">
            <FontIcon
                x:Name="KindIcon"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="Label"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />
        </StackPanel>

        <local:StudioLaneBlockHandles
            x:Name="BlockHandles"
            GripBrush="{ThemeResource TextFillColorPrimaryBrush}"
            SelectedGripBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
            TabBrush="{ThemeResource AccentFillColorDefaultBrush}"
            TabGripBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    </Grid>
</local:StudioRangeBlock>
