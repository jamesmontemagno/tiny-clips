<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.Studio.StudioPreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <!--  No background: everywhere but the handle, the pointer goes through to the preview.  -->
    <Canvas>
        <Grid
            x:Name="BubbleHandle"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            PointerCanceled="OnHandlePointerEnded"
            PointerCaptureLost="OnHandlePointerEnded"
            PointerEntered="OnHandlePointerEntered"
            PointerExited="OnHandlePointerExited"
            PointerMoved="OnHandlePointerMoved"
            PointerPressed="OnHandlePointerPressed"
            PointerReleased="OnHandlePointerEnded"
            ToolTipService.ToolTip="Drag to move the camera"
            Visibility="Collapsed">
            <Rectangle
                x:Name="BubbleOutline"
                IsHitTestVisible="False"
                Opacity="0"
                RadiusX="8"
                RadiusY="8"
                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                StrokeDashArray="3,2"
                StrokeThickness="2" />
        </Grid>
    </Canvas>
</UserControl>
