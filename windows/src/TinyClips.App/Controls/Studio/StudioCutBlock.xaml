<?xml version="1.0" encoding="utf-8" ?>
<local:StudioRangeBlock
    x:Class="TinyClips.App.Controls.Studio.StudioCutBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyClips.App.Controls.Studio"
    IsTabStop="False">

    <local:StudioRangeBlock.Resources>
        <ResourceDictionary>
            <!--
                A cut is a stretch that has been taken out, so its block is not filled: it is
                hatched, in the color of the text and not in the accent color, inside a dashed
                outline. A tint is not one of a contrast theme's colors, so there the hatching is
                the text color at full strength on the window color, and the selected cut's the
                highlight color.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StudioCutBlockBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush
                        x:Key="StudioCutBlockHatchBrush"
                        Opacity="0.3"
                        Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush
                        x:Key="StudioCutBlockSelectedHatchBrush"
                        Opacity="0.75"
                        Color="{ThemeResource SystemAccentColorDark1}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StudioCutBlockBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush
                        x:Key="StudioCutBlockHatchBrush"
                        Opacity="0.3"
                        Color="{ThemeResource TextFillColorPrimary}" />
                    <SolidColorBrush
                        x:Key="StudioCutBlockSelectedHatchBrush"
                        Opacity="0.75"
                        Color="{ThemeResource SystemAccentColorLight2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioCutBlockBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioCutBlockHatchBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioCutBlockSelectedHatchBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </local:StudioRangeBlock.Resources>

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <!--  The selected cut has a solid outline, twice as thick, so it is not told apart by color alone.  -->
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Hatch.Stroke" Value="{ThemeResource StudioCutBlockSelectedHatchBrush}" />
                        <Setter Target="Outline.Visibility" Value="Collapsed" />
                        <Setter Target="SelectedOutline.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Rectangle
            Fill="{ThemeResource StudioCutBlockBackgroundBrush}"
            RadiusX="4"
            RadiusY="4" />

        <!--
            The hatching: slanted lines, laid out in code for the size of the block and cut off
            at its edges. They are lines and not a repeating gradient brush, because whatever is
            drawn over an absolutely mapped, repeating gradient comes out at half its strength.
        -->
        <Canvas x:Name="HatchArea" IsHitTestVisible="False">
            <Path
                x:Name="Hatch"
                Stroke="{ThemeResource StudioCutBlockHatchBrush}"
                StrokeThickness="2.5" />
        </Canvas>

        <!--
            The handles at the two ends, under the outline. A grip mark on hatching would not be
            seen, so each stands on a plate of the window's own color, as the scissors do. A
            selected cut is not filled, so its marks keep the color of the text; the tabs outside
            a narrow selected cut are that color, as its outline is, with the mark in the
            window's.
        -->
        <local:StudioLaneBlockHandles
            x:Name="BlockHandles"
            GripBrush="{ThemeResource TextFillColorPrimaryBrush}"
            PlateBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            SelectedGripBrush="{ThemeResource TextFillColorPrimaryBrush}"
            TabBrush="{ThemeResource TextFillColorPrimaryBrush}"
            TabGripBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <Rectangle
            x:Name="Outline"
            RadiusX="4"
            RadiusY="4"
            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
            StrokeDashArray="3,2"
            StrokeThickness="1" />
        <Rectangle
            x:Name="SelectedOutline"
            RadiusX="4"
            RadiusY="4"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="2"
            Visibility="Collapsed" />

        <!--
            The scissors and the length stand on a plate of the window's own color, clear of the
            hatching. The list item says all of this in its name, so screen readers skip the parts.
        -->
        <Border
            x:Name="Plate"
            Height="16"
            Padding="4,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="3"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!--  Scissors: something was cut out here.  -->
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Glyph="&#xE8C6;" />
                <!--  How long the cut is, such as "1.0 s".  -->
                <TextBlock
                    x:Name="LengthText"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</local:StudioRangeBlock>
