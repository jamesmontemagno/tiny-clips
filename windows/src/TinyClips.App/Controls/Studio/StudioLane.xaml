<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Controls.Studio.StudioLane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <!--
        One lane of the Studio timeline. The scene lane, the zoom lane and the cut lane are this
        control, each with blocks of its own kind. Positions are set in code: the blocks are
        placed by time, not by layout. The pointer is handled here for the whole lane, so a press
        is told to be on a block, on one of its ends, or on the lane from where along the lane it
        is.
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerCanceled="OnPointerEnded"
        PointerCaptureLost="OnPointerEnded"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerEnded"
        SizeChanged="OnRootSizeChanged">
        <!--  The whole recording, on the time scale of the trim bar under the lanes.  -->
        <Border
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            IsHitTestVisible="False" />

        <!--  What a lane without blocks says. Its text and automation id come from the lane.  -->
        <TextBlock
            x:Name="EmptyText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            Visibility="Collapsed" />

        <!--  One block for each scene, zoom or cut, in time order.  -->
        <Canvas x:Name="Blocks" />

        <Canvas IsHitTestVisible="False">
            <Rectangle
                x:Name="PlayheadLine"
                Width="1"
                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                Opacity="0.6" />
        </Canvas>
    </Grid>
</UserControl>
