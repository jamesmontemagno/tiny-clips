<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TinyClips.App.Settings.Sections.AboutSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBlock
            Margin="4,8,0,4"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="About" />

        <Border Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tiny Clips for Windows" />
                <TextBlock
                    x:Name="AboutVersionText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Version" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="A fast, beautiful screen capture app for screenshots, video, and GIFs." />
            </StackPanel>
        </Border>

        <Border
            x:Name="DirectBuildUpdatesCard"
            Visibility="Collapsed"
            Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates (Direct build)" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="This build updates through winget (`winget upgrade Refractored.TinyClips`) or by downloading the latest GitHub release." />
                <TextBlock
                    x:Name="UpdateStatusText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Check for updates to see whether a newer version is available." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CheckForUpdatesButton"
                        Content="Check for updates"
                        Click="OnCheckForUpdatesClicked" />
                    <Button
                        x:Name="CopyWingetCommandButton"
                        Visibility="Collapsed"
                        Content="Copy winget command"
                        Click="OnCopyWingetCommandClicked" />
                    <Button
                        x:Name="OpenLatestReleaseButton"
                        Visibility="Collapsed"
                        Content="Open latest release"
                        Click="OnOpenLatestReleaseClicked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            x:Name="StoreBuildUpdatesCard"
            Visibility="Collapsed"
            Style="{StaticResource SettingCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates (Microsoft Store build)" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="This build is updated by Microsoft Store auto-update; direct/winget update UI is intentionally hidden." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Source code" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="View the project, open an issue or feature request, and contribute on GitHub." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Spacing="4">
                    <HyperlinkButton
                        AutomationProperties.AutomationId="AboutRepoLink"
                        AutomationProperties.Name="Open the Tiny Clips GitHub repository"
                        Content="GitHub repository"
                        NavigateUri="https://github.com/jamesmontemagno/tiny-clips" />
                    <Button
                        x:Name="AboutFileBugButton"
                        AutomationProperties.AutomationId="AboutFileBugButton"
                        AutomationProperties.Name="Open quick bug report form"
                        Click="OnFileBugClick"
                        Content="File a bug…" />
                    <HyperlinkButton
                        x:Name="AboutDetailedIssueLink"
                        AutomationProperties.AutomationId="AboutDetailedIssueLink"
                        AutomationProperties.Name="Open detailed issue template on GitHub"
                        Content="Open detailed issue template" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            x:Name="AboutCopyrightText"
            Margin="4,4,0,0"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="© Refractored LLC" />
    </StackPanel>
</UserControl>
