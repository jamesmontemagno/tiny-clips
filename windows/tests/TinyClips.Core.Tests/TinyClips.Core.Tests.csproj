<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyClips.Core\TinyClips.Core.csproj" />
    <!-- Exercise the UI-free diagnostic/coalescing helpers without loading WinUI in Core tests. -->
    <Compile Include="..\..\src\TinyClips.App\Infrastructure\CoalescedAction.cs" Link="AppInfrastructure\CoalescedAction.cs" />
    <Compile Include="..\..\src\TinyClips.App\Infrastructure\WindowOpenTrace.cs" Link="AppInfrastructure\WindowOpenTrace.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>