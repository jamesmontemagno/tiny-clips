{
  "app-id": "com.refractored.tinyclips.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "tinyclips-portal-probe",
  "finish-args": ["--socket=wayland", "--device=dri"],
  "modules": [
    {
      "name": "portal-probe",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": { "CARGO_HOME": "/run/build/portal-probe/cargo", "CARGO_NET_OFFLINE": "true" }
      },
      "build-commands": [
        "cargo build --frozen --release",
        "install -Dm755 target/release/tinyclips-portal-probe /app/bin/tinyclips-portal-probe",
        "install -Dm644 com.refractored.tinyclips.Devel.desktop /app/share/applications/com.refractored.tinyclips.Devel.desktop",
        "install -Dm644 com.refractored.tinyclips.Devel.svg /app/share/icons/hicolor/scalable/apps/com.refractored.tinyclips.Devel.svg"
      ],
      "test-commands": ["cargo test --frozen --release", "/app/bin/tinyclips-portal-probe --help"],
      "sources": [
        "packaging/cargo-sources.json",
        { "type": "dir", "path": "spikes/portal-capture", "skip": ["target"] },
        { "type": "file", "path": "packaging/com.refractored.tinyclips.Devel.desktop" },
        { "type": "file", "path": "packaging/com.refractored.tinyclips.Devel.svg" }
      ]
    }
  ]
}
