<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyClips.Cli\TinyClips.Cli.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <Content Include="..\..\..\shared\automation\fixtures\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="AutomationFixtures" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
